@{
    ViewData["Title"] = "Strona Główna";
}

<div class="row">
    <div class="col-12 mt-4">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">Witaj w systemie</h3>
            </div>
            <div class="card-body">
                <p>Jeśli to widzisz, to znaczy, że @RenderBody w końcu zadziałało i AdminLTE renderuje się poprawnie!</p>
                <div class="mt-3">
                    <button class="btn btn-primary">Policja (Primary)</button>
                    <button class="btn btn-danger">Straż (Danger)</button>
                    <button class="btn btn-success">Szpital (Success)</button>
                    <button class="btn btn-warning">112 (Warning)</button>
                    <button class="btn btn-dark">Ciemny (Dark)</button>
                </div>
            </div>
        </div>
    </div>
</div>