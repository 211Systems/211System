@{
    ViewData["Title"] = "Strona Główna";
}

<div class="row">
    <div class="col-12 mt-4">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">Witaj w systemie</h3>
            </div>
            <div class="card-body">
                <p>Jeśli to widzisz, to znaczy, że @RenderBody w końcu zadziałało i AdminLTE renderuje się poprawnie!</p>
                <div class="mt-3">
                    <button class="btn btn-primary">Policja (Primary)</button>
                    <button class="btn btn-danger">Straż (Danger)</button>
                    <button class="btn btn-success">Szpital (Success)</button>
                    <button class="btn btn-warning">112 (Warning)</button>
                    <button class="btn btn-dark">Ciemny (Dark)</button>
                    <div class="mb-3">
                        <button onclick="fetchNasa(false)" class="btn btn-danger">
                            <i class="fas fa-satellite"></i> Skanuj NASA (LIVE)
                        </button>
                        <button onclick="fetchNasa(true)" class="btn btn-warning">
                            <i class="fas fa-vial"></i> Skanuj NASA (DEMO PREZENTACYJNE)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function fetchNasa(isDemo) {
        const token = window.jwtToken || localStorage.getItem('jwt');

        const url = `/api/Nasa/fetch?isDemo=${isDemo}`;

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Authorization': 'Bearer ' + token }
            });

            if (response.ok) {
                const data = await response.json();
                alert(`Skanowanie zakończone.\nZnalezione anomalie: ${data.totalAnomaliesDetected}\nWygenerowane incydenty: ${data.incidentsGenerated}`);
             if(window.refreshAll)
                window.refreshAll();
            } else {
                const err = await response.text();
                alert("Błąd: " + err);
            }
        } catch (e) {
            console.error(e);
            alert("Błąd sieci!");
        }
    }
</script>