<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - System 211</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=2" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico?v=2" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
        <link rel="stylesheet" href="~/css/site.css" />

        <style>
                .user-avatar-nav {
                    width: 32px !important;
                    height: 32px !important;
                    border-radius: 50%;
                    object-fit: cover;
                    border: 1px solid rgba(255,255,255,0.3);
                    margin-right: 8px;
                }

                .user-menu .dropdown-menu {
                    border-radius: 8px !important;
                    overflow: hidden;
                    padding: 0 !important;
                    width: 280px !important;
                    left: auto !important;
                    right: 0 !important;
                    box-shadow: 0 5px 15px rgba(0,0,0,0.5) !important;
                }

                .user-header {
                    background-color: #007bff !important;
                    padding: 20px !important;
                    text-align: center !important;
                    display: flex !important;
                    flex-direction: column !important;
                    align-items: center !important;
                }

                .user-avatar-big {
                    width: 90px !important;
                    height: 90px !important;
                    border-radius: 50%;
                    object-fit: cover;
                    border: 3px solid rgba(255,255,255,0.4);
                    margin-bottom: 10px;
                    background-color: #fff;
                }

                .user-footer {
                    background-color: #343a40 !important;
                    padding: 15px !important;
                    display: flex !important;
                    justify-content: space-between !important;
                }

                .avatar-upload-overlay {
                    position: absolute;
                    bottom: 10px;
                    right: 5px;
                    background: rgba(0,0,0,0.6);
                    border-radius: 50%;
                    padding: 6px;
                    font-size: 11px;
                }

                #profile-email {
                    color: #fff !important;
                    display: block;
                    margin-bottom: 5px;
                    word-break: break-all;
                }
        </style>
    </head>
    <body class="hold-transition layout-top-nav dark-mode">
        <div class="wrapper">
        <nav class="main-header navbar navbar-expand-md navbar-dark bg-dark border-bottom-0 shadow-sm">
            <div class="container-fluid">

                <div class="d-flex align-items-center mr-auto">

                    <a href="/" class="navbar-brand d-flex align-items-center m-0 pr-3">
                        <img src="~/logo.png" alt="Logo System 211" class="elevation-3" style="opacity: .9; height: 32px; width: auto; border-radius: 5px; margin-right: 10px;">
                        <span class="brand-text font-weight-bold">System 211</span>
                    </a>

                    <ul class="navbar-nav" id="main-navigation">
                        <li class="nav-item dropdown d-none" id="menu-admin">
                            <a id="dd-admin" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-danger font-weight-bold">
                                <i class="fas fa-cogs"></i> Administracja Globalna
                            </a>
                            <ul aria-labelledby="dd-admin" class="dropdown-menu border-0 shadow">
                                <li><a href="/Admin/Departments" class="dropdown-item"><i class="fas fa-city mr-2"></i> Zarządzanie Placówkami</a></li>
                                <li><a href="/Admin/Users" class="dropdown-item"><i class="fas fa-users-cog mr-2"></i> Zarządzanie Kadrą (Globalnie)</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown d-none" id="menu-dispatch">
                            <a id="dd-dispatch" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-warning font-weight-bold">
                                <i class="fas fa-headset"></i> CPR 112
                            </a>
                            <ul aria-labelledby="dd-dispatch" class="dropdown-menu border-0 shadow">
                                <li><a href="/Dispatch/Home/Index#" class="dropdown-item"><i class="fas fa-file-medical mr-2"></i> Centrum Zgłoszeń</a></li>
                                <li id="nav-admin-cpr-container" class="d-none">
                                    <a href="/Dispatch/Home/Index#admin-operator-section" class="dropdown-item">
                                        <i class="fas fa-user-plus mr-2 text-warning"></i> Zarządzanie Kadrą CPR
                                    </a>
                                </li>
                                <li id="nav-admin-centers-container" class="d-none">
                                    <a href="/Dispatch/Home/Index#admin-centers-section" class="dropdown-item text-primary">
                                        <i class="fas fa-hospital mr-2"></i> Zarządzanie Placówkami
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown d-none" id="menu-medic-manager">
                            <a id="dd-medic-mgr" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-success font-weight-bold">
                                <i class="fas fa-hospital-user"></i> Zarządzanie Szpitalem
                            </a>
                            <ul aria-labelledby="dd-medic-mgr" class="dropdown-menu border-0 shadow">
                                <li id="link-hospitals" class="d-none"><a href="/Medic/Hospitals" class="dropdown-item"><i class="fas fa-clinic-medical mr-2 text-success"></i> Placówki i Kadra</a></li>
                                <li id="link-ambulances" class="d-none"><a href="/Medic/Ambulances" class="dropdown-item"><i class="fas fa-ambulance mr-2 text-success"></i> Flota Karetek</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/Medic/Aviation/Index">
                                        <i class="fas fa-helicopter text-success"></i> Flota Lotnicza (HEMS)
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown d-none" id="menu-medic-worker">
                            <a id="dd-medic-wrk" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-success font-weight-bold">
                                <i class="fas fa-heartbeat"></i> Praca Medyczna
                            </a>
                            <ul aria-labelledby="dd-medic-wrk" class="dropdown-menu border-0 shadow">
                                <li id="link-operations" class="d-none"><a href="/Medic/Operations" class="dropdown-item"><i class="fas fa-briefcase-medical mr-2 text-success"></i> Akcje Medyczne</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown d-none" id="menu-police-manager">
                            <a id="dd-police-mgr" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-primary font-weight-bold">
                                <i class="fas fa-shield-alt"></i> Zarządzanie Policją
                            </a>
                            <ul aria-labelledby="dd-police-mgr" class="dropdown-menu border-0 shadow">
                                <li id="link-police-depts" class="d-none"><a href="/Police/Home" class="dropdown-item"><i class="fas fa-building mr-2 text-primary"></i> Placówki i Kadra</a></li>
                                <li id="link-police-cars" class="d-none"><a href="/Police/Cars" class="dropdown-item"><i class="fas fa-car mr-2 text-primary"></i> Flota Radiowozów</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/Police/Aviation/Index">
                                        <i class="fas fa-helicopter text-primary"></i> Lotnictwo Policyjne
                                    </a>
                                </li>
                            </ul>
@*                                 <a class="dropdown-item" href="/Aviation/Units/Index">
                                    <i class="fas fa-plane"></i> Rejestr Statków Powietrznych
                                </a>
                                <a class="dropdown-item" href="/Aviation/Operations/Index">
                                    <i class="fas fa-clipboard-list text-warning"></i> Dziennik Lotów (Interwencje)
                                </a> *@
                        </li>

                        <li class="nav-item dropdown d-none" id="menu-police-worker">
                            <a id="dd-police-wrk" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-primary font-weight-bold">
                                <i class="fas fa-balance-scale"></i> Służba Policyjna
                            </a>
                            <ul aria-labelledby="dd-police-wrk" class="dropdown-menu border-0 shadow">
                                <li id="link-police-operations" class="d-none"><a href="/Police/Operations" class="dropdown-item"><i class="fas fa-user-shield mr-2 text-primary"></i> Interwencje</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown d-none" id="menu-fire-manager">
                            <a id="dd-fire-mgr" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-danger font-weight-bold">
                                <i class="fas fa-fire-extinguisher"></i> Zarządzanie Strażą
                            </a>
                            <ul aria-labelledby="dd-fire-mgr" class="dropdown-menu border-0 shadow">
                                <li id="link-fire-depts" class="d-none"><a href="/Fire/Home" class="dropdown-item"><i class="fas fa-building mr-2 text-danger"></i> Placówki i Kadra</a></li>
                                <li id="link-fire-trucks" class="d-none"><a href="/Fire/Trucks" class="dropdown-item"><i class="fas fa-truck-moving mr-2 text-danger"></i> Flota Wozów</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/Fire/Aviation/Index">
                                        <i class="fas fa-plane text-danger"></i> Lotnictwo Gaśnicze
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown d-none" id="menu-fire-worker">
                            <a id="dd-fire-wrk" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-danger font-weight-bold">
                                <i class="fas fa-fire"></i> Służba Strażacka
                            </a>
                            <ul aria-labelledby="dd-fire-wrk" class="dropdown-menu border-0 shadow">
                                <li id="link-fire-operations" class="d-none"><a href="/Fire/Operations" class="dropdown-item"><i class="fas fa-fire-alt mr-2 text-danger"></i> Akcje Ratownicze</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>

                <ul class="navbar-nav">
                    <li class="nav-item d-none d-sm-flex align-items-center mr-3">
                        <span class="badge badge-dark p-2" id="live-clock" style="font-size: 1rem;">00:00:00</span>
                    </li>

                    <li class="nav-item dropdown user-menu">
                        <a href="#" class="nav-link dropdown-toggle d-flex align-items-center" data-toggle="dropdown">
                            <i class="fas fa-user-circle fa-lg mr-2" id="nav-user-icon"></i>
                            <img id="nav-user-avatar" src="" class="user-avatar-nav d-none" alt="Avatar">
                            <span class="d-none d-md-inline" id="nav-user-name">Ładowanie...</span>
                        </a>

                        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right shadow-lg border-0">
                            <div id="auth-logged-in" class="d-none">
                                <div class="user-header">
                                    <div style="position: relative; display: inline-block; cursor: pointer;" onclick="document.getElementById('avatarUploadInput').click();">
                                        <i class="fas fa-user-circle fa-5x text-white mb-2" id="profile-user-icon"></i>
                                        <img id="profile-user-avatar" src="" class="user-avatar-big d-none" alt="User Image">
                                        <div class="avatar-upload-overlay">
                                            <i class="fas fa-camera text-white"></i>
                                        </div>
                                    </div>
                                    <input type="file" id="avatarUploadInput" style="display:none" accept="image/*">
                                    <p>
                                        <span id="profile-email">email@system211.pl</span>
                                        <small id="profile-role-container">Rola: <span id="profile-role" class="text-warning font-weight-bold">Brak</span></small>
                                    </p>
                                </div>
                                <div class="user-footer">
                                    <a href="/Home/Profile" class="btn btn-outline-light btn-sm px-3">Profil</a>
                                    <button onclick="logout()" class="btn btn-danger btn-sm px-3">Wyloguj</button>
                                </div>
                            </div>
                            <div id="auth-logged-out">
                                <div class="p-4 text-center">
                                    <a href="/AuthView/Login" class="btn btn-primary btn-block">Zaloguj się</a>
                                </div>
                            </div>
                        </div>
                    </li>
                </ul>

            </div>
        </nav>

            <div class="content-wrapper">
                <div class="content pt-4">
                    <div class="container-fluid">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/dist/js/adminlte.min.js"></script>
        <script src="~/js/auth-layout.js" asp-append-version="true"></script>
        <script src="~/js/auth-handler.js" asp-append-version="true"></script>
        <script>
            window.jwtToken = localStorage.getItem('jwt');

            (async () => {
                if (window.jwtToken) {
                    await window.ensureValidToken();
                }
            })();
        </script>
        <script src="~/js/app-core.js"></script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>