<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - System 211</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
</head>

<body class="hold-transition layout-top-nav dark-mode">
    <div class="wrapper">
        <nav class="main-header navbar navbar-expand-md navbar-dark bg-dark">
            <div class="container-fluid">

                <ul class="navbar-nav" id="main-navigation">
                    <li class="nav-item d-none d-sm-inline-block">
                        <a href="#" id="nav-home-link" class="nav-link"><i class="fas fa-home"></i> Mój Panel</a>
                    </li>

                    <li class="nav-item dropdown d-none" id="menu-admin">
                        <a id="dd-admin" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-danger font-weight-bold">
                            <i class="fas fa-cogs"></i> Administracja Globalna
                        </a>
                        <ul aria-labelledby="dd-admin" class="dropdown-menu border-0 shadow">
                            <li><a href="/Admin/Home/Index" class="dropdown-item">Zarządzanie Placówkami Systemu</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown d-none" id="menu-medic-manager">
                        <a id="dd-medic-mgr" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-success">
                            <i class="fas fa-hospital-user"></i> Zarządzanie Szpitalem
                        </a>
                        <ul aria-labelledby="dd-medic-mgr" class="dropdown-menu border-0 shadow">
                            <li><a href="/Medic/Staff/Add" class="dropdown-item">Zatrudnij Pracownika</a></li>
                            <li><a href="/Medic/Ambulances" class="dropdown-item">Flota Karetek</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown d-none" id="menu-medic-worker">
                        <a id="dd-medic-wrk" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-success">
                            <i class="fas fa-heartbeat"></i> Praca Medyka
                        </a>
                        <ul aria-labelledby="dd-medic-wrk" class="dropdown-menu border-0 shadow">
                            <li><a href="/Medic/Patients" class="dropdown-item">Moi Pacjenci</a></li>
                            <li><a href="/Medic/Calls" class="dropdown-item">Wezwania w toku</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown d-none" id="menu-police-manager">
                        <a id="dd-police-mgr" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-primary">
                            <i class="fas fa-building-shield"></i> Zarządzanie Komendą
                        </a>
                        <ul aria-labelledby="dd-police-mgr" class="dropdown-menu border-0 shadow">
                            <li><a href="/Police/Staff/Add" class="dropdown-item">Dodaj Policjanta</a></li>
                            <li><a href="/Police/Cars" class="dropdown-item">Zarządzanie Radiowozami</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown d-none" id="menu-police-worker">
                        <a id="dd-police-wrk" href="#" data-toggle="dropdown" class="nav-link dropdown-toggle text-primary">
                            <i class="fas fa-shield-alt"></i> Praca Policjanta
                        </a>
                        <ul aria-labelledby="dd-police-wrk" class="dropdown-menu border-0 shadow">
                            <li><a href="/Police/Interventions" class="dropdown-item">Bieżące Interwencje</a></li>
                        </ul>
                    </li>

                </ul>

                <ul class="navbar-nav ml-auto">
                    <li class="nav-item d-none d-sm-inline-block d-flex align-items-center mr-3">
                        <span class="text-light font-weight-bold" id="live-clock">00:00:00</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                            <i class="fas fa-expand-arrows-alt"></i>
                        </a>
                    </li>
                    <li class="nav-item dropdown user-menu">
                        <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">
                            <i class="fas fa-user-circle fa-lg mr-1"></i>
                            <span class="d-none d-md-inline" id="nav-user-name">Ładowanie...</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-right dropdown-menu-end shadow-lg" style="left: auto; right: 0;">
                            <div id="auth-logged-in" class="d-none">
                            <li class="user-header bg-primary">
                                <i class="fas fa-user-circle fa-4x text-white mt-2 mb-2"></i>
                                <p>
                                    <span id="profile-email">email@test.pl</span>
                                    <small>Rola: <span id="profile-role">Brak</span></small>
                                </p>
                            </li>
                            <li class="user-footer d-flex justify-content-between">
                                <a href="/Auth/Profile" class="btn btn-default btn-flat">Profil</a>
                                <button onclick="logout()" class="btn btn-danger btn-flat">
                                    <i class="fas fa-sign-out-alt"></i> Wyloguj
                                </button>
                            </li>
            </div>
            <div id="auth-logged-out">
                <li class="user-footer text-center">
                    <a href="/AuthView/Login" class="btn btn-primary btn-flat w-100">Zaloguj się</a>
                </li>
            </div>
            </ul>
            </li>
            </ul>
    </div>
    </nav>

    <div class="content-wrapper">
        <div class="content">
            <div class="container-fluid pt-4">
                @RenderBody()
            </div>
        </div>
    </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/dist/js/adminlte.min.js"></script>
    <script src="~/js/auth-layout.js"></script>

    <script>
        function updateClock() {
            const now = new Date();
            document.getElementById('live-clock').textContent = now.toLocaleTimeString('pl-PL');
        }
        updateClock();
        setInterval(updateClock, 1000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>