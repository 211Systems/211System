@{
    ViewData["Title"] = "Zarządzanie Szpitalem";
}

<div class="row">
    <div class="col-md-4">
        <div class="card card-success card-outline">
            <div class="card-body box-profile">
                <h3 class="profile-username text-center" id="hosp-name">Ładowanie...</h3>
                <p class="text-muted text-center" id="hosp-sor">...</p>
                <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item">
                        <b>Adres</b> <a class="float-right" id="hosp-address">...</a>
                    </li>
                </ul>
                <a href="/Medic/Hospitals" class="btn btn-success btn-block"><b>Wróć do listy</b></a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-success">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title m-0">Zatrudnieni Medycy</h3>
                <button type="button" class="btn btn-sm btn-light ml-auto text-success d-none" id="btn-open-modal" data-toggle="modal" data-target="#addParamedicModal">
                    <i class="fas fa-user-plus"></i> Zatrudnij Medyka
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th style="width: 70px;" class="text-center">Awatar</th>
                            <th>Imię i Nazwisko</th>
                            <th>Nr Prawa Wyk. Zawodu</th>
                            <th>Specjalizacja</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody id="paramedics-table-body">
                        <tr><td colspan="5" class="text-center">Ładowanie personelu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addParamedicModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content dark-mode">
            <div class="modal-header bg-success">
                <h5 class="modal-title">Rejestracja Medyka</h5>
                <button type="button" class="close text-white test-end float-end" data-dismiss="modal" aria-label="Zamknij" style="outline: none; border: none;">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form id="addParamedicForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Imię</label>
                        <input type="text" id="staffName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Nazwisko</label>
                        <input type="text" id="staffLastName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Email (Login)</label>
                        <input type="email" id="staffEmail" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Nr Prawa Wykonywania Zawodu</label>
                        <input type="text" id="staffLicense" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Hierarchia / Rola w systemie</label>
                        <select id="staffRole" class="form-control" required>
                        </select>
                    </div>
                    
                    <div id="generated-password-alert" class="alert alert-warning d-none">
                        <h5><i class="icon fas fa-check"></i> Konto aktywne!</h5>
                        Tymczasowe hasło pracownika: <strong id="temp-password-display" style="font-size: 1.2em;"></strong>
                    </div>
                    <p id="form-error" class="text-danger d-none"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Zamknij</button>
                    <button type="submit" class="btn btn-success" id="btn-submit">Dodaj do systemu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api-details-handler.js"></script>
    <script>
        const currHospitalId = window.location.pathname.split('/').filter(Boolean).pop();

        setupDepartmentDetails({
            departmentId: currHospitalId,
            endpoints: {
                department: '/api/Medical/hospitals',
                staff: '/api/Medical/paramedics',
                addStaff: '/api/Medical/paramedics'
            },
            foreignKeyField: 'hospitalId',
            emptyStaffColspan: 5,
            addStaffFormId: 'addParamedicForm',

            onInit: (decodedToken) => {
                if (!decodedToken) return;

                let roleClaim = decodedToken["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || decodedToken.role;
                const roles = Array.isArray(roleClaim) ? roleClaim : [roleClaim];

                const roleSelect = document.getElementById('staffRole');
                if (roles.includes("Admin") || roles.includes("Kierownik Szpitala")) {
                    if (roleSelect) {
                        roleSelect.innerHTML = `
                            <option value="Kierownik Szpitala">Kierownik Szpitala</option>
                            <option value="Lekarz">Lekarz</option>
                            <option value="Medyk">Medyk</option>
                        `;
                    }
                } else if (roles.includes("Lekarz")) {
                    if (roleSelect) {
                        roleSelect.innerHTML = `<option value="Medyk">Medyk</option>`;
                    }
                }
            },

            renderDepartment: (dept) => {
                document.getElementById('hosp-name').textContent = dept.name || dept.Name;
                document.getElementById('hosp-address').textContent = dept.address || dept.Address;

                const hasSor = dept.hasSOR !== undefined ? dept.hasSOR : dept.HasSOR;
                document.getElementById('hosp-sor').innerHTML = hasSor
                    ? '<span class="badge bg-danger">Posiada oddział SOR</span>'
                    : '<span class="badge bg-secondary">Brak oddziału SOR</span>';
            },

            renderStaffRow: (p, decodedToken, allStaff) => {
                let roles = [];
                let email = "";
                if (decodedToken) {
                    let roleClaim = decodedToken["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || decodedToken.role;
                    roles = Array.isArray(roleClaim) ? roleClaim : [roleClaim];
                    email = decodedToken["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"] || decodedToken.email || "";
                }

                const isAdmin = roles.includes("Admin");
                const isKierownik = roles.includes("Kierownik Szpitala");
                const isLekarz = roles.includes("Lekarz");

                let isMyHospital = false;
                const myRecord = allStaff.find(staff => staff.email === email || staff.Email === email);
                if (myRecord && (myRecord.hospitalId === currHospitalId || myRecord.HospitalId === currHospitalId)) {
                    isMyHospital = true;
                }

                const btnOpenModal = document.getElementById('btn-open-modal');
                if ((isAdmin || isKierownik) || (isLekarz && isMyHospital)) {
                    if (btnOpenModal) btnOpenModal.classList.remove('d-none');
                }

                const firstName = p.name || p.Name;
                const lastName = p.lastName || p.LastName;
                const employeeRank = p.rank || p.Rank || "Medyk";
                const fallbackAvatar = `https://ui-avatars.com/api/?name=${firstName}+${lastName}&background=random&color=fff`;
                const avatarSrc = p.avatarUrl || p.AvatarUrl || fallbackAvatar;

                let deleteBtn = '';
                if (isAdmin || isKierownik || (isLekarz && isMyHospital && employeeRank === "Medyk")) {
                    deleteBtn = `<button onclick="alert('Usunięcie w przyszłości')" class="btn btn-sm btn-danger float-right ml-2" title="Zwolnij"><i class="fas fa-user-times"></i></button>`;
                }

                return `
                    <tr>
                        <td class="text-center align-middle">
                            <img src="${avatarSrc}" alt="Awatar" class="img-circle elevation-1" style="width: 45px; height: 45px; object-fit: cover;">
                        </td>
                        <td class="align-middle">
                            <b>${firstName} ${lastName}</b><br/>
                            <small class="text-warning font-weight-bold">${employeeRank}</small>
                        </td>
                        <td class="align-middle">${p.licenseNumber || p.LicenseNumber}</td>
                        <td class="align-middle"><span class="badge bg-success">${p.specialization || p.Specialization || "Medycyna"}</span></td>
                        <td class="align-middle">${p.email || p.Email} ${deleteBtn}</td>
                    </tr>
                `;
            },

            buildStaffPayload: () => {
                const roleEl = document.getElementById('staffRole');
                return {
                    name: document.getElementById('staffName').value,
                    lastName: document.getElementById('staffLastName').value,
                    email: document.getElementById('staffEmail').value,
                    licenseNumber: document.getElementById('staffLicense').value,
                    specialization: "Medycyna",
                    hospitalId: currHospitalId,
                    rank: roleEl ? roleEl.value : "Medyk",
                    paraAccountId: "Zostanie-Wygenerowane-W-Backendzie"
                };
            }
        });
    </script>
}