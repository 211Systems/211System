@{
    ViewData["Title"] = "Zarządzanie Szpitalem";
}

<div class="row">
    <div class="col-md-4">
        <div class="card card-success card-outline">
            <div class="card-body box-profile">
                <h3 class="profile-username text-center" id="hosp-name">Ładowanie...</h3>
                <p class="text-muted text-center" id="hosp-sor">...</p>
                <p class="text-muted text-center" id="hosp-helipad">...</p>
                <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item">
                        <b>Adres</b> <a class="float-right" id="hosp-address">...</a>
                    </li>
                </ul>
                <div id="admin-hospital-actions" class="d-none mb-3">
                    <button class="btn btn-warning btn-block mb-2" data-toggle="modal" data-target="#editHospitalModal">
                        <b><i class="fas fa-edit"></i> Edytuj Szpital</b>
                    </button>
                    <button class="btn btn-danger btn-block" onclick="window.deleteHospital()">
                        <b><i class="fas fa-trash"></i> Usuń Szpital</b>
                    </button>
                </div>
                <a href="/Medic/Hospitals" class="btn btn-success btn-block"><b>Wróć do listy</b></a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-success">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title m-0">Zatrudnieni Medycy</h3>
                <button type="button" class="btn btn-sm btn-light ml-auto text-success d-none" id="btn-open-modal" data-toggle="modal" data-target="#addParamedicModal">
                    <i class="fas fa-user-plus"></i> Zatrudnij Medyka
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th style="width: 70px;" class="text-center">Awatar</th>
                                <th>Imię, Nazwisko i Rola</th>
                                <th>Nr Prawa Wyk. Zawodu</th>
                                <th>Email i Status</th>
                                <th class="text-right">Akcje</th>
                            </tr>
                        </thead>
                        <tbody id="staff-table-body">
                            <tr><td colspan="5" class="text-center">Ładowanie...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addParamedicModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content dark-mode">
            <div class="modal-header bg-success">
                <h5 class="modal-title">Rejestracja Medyka</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <form id="addStaffForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Imię</label>
                        <input type="text" id="staffName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Nazwisko</label>
                        <input type="text" id="staffLastName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Email (Login)</label>
                        <input type="email" id="staffEmail" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Nr Prawa Wykonywania Zawodu</label>
                        <input type="text" id="staffLicense" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Hierarchia / Rola</label>
                        <select id="staffRole" class="form-control" required>
                            <option value="Medyk">Medyk</option>
                            <option value="Lekarz">Lekarz</option>
                            <option value="Kierownik Szpitala">Kierownik Szpitala</option>
                        </select>
                    </div>
                    <div id="generated-password-alert" class="alert alert-warning d-none">
                        Tymczasowe hasło: <strong id="temp-password-display"></strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Zamknij</button>
                    <button type="submit" class="btn btn-success" id="btn-submit-staff">Dodaj do systemu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editHospitalModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content dark-mode">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-dark">Edytuj Placówkę</h5>
                <button type="button" class="close text-dark" data-dismiss="modal">&times;</button>
            </div>
            <form id="editHospitalForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Nazwa</label>
                        <input type="text" id="editHospName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Adres</label>
                        <input type="text" id="editHospAddress" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Czy posiada SOR?</label>
                        <select id="editHospSor" class="form-control"><option value="true">TAK</option><option value="false">NIE</option></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-warning">Zapisz</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editParamedicModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content dark-mode">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-dark">Edytuj Pracownika</h5>
                <button type="button" class="close text-dark" data-dismiss="modal">&times;</button>
            </div>
            <form id="editParamedicForm">
                <div class="modal-body">
                    <input type="hidden" id="editEmpId">
                    <div class="form-group"><label>Imię</label><input type="text" id="editEmpName" class="form-control" required></div>
                    <div class="form-group"><label>Nazwisko</label><input type="text" id="editEmpLastName" class="form-control" required></div>
                    <div class="form-group"><label>Nr Prawa Wyk.</label><input type="text" id="editEmpLicense" class="form-control" required></div>
                    <div class="form-group">
                        <label>Rola</label>
                        <select id="editEmpRole" class="form-control" required>
                            <option value="Medyk">Medyk</option>
                            <option value="Lekarz">Lekarz</option>
                            <option value="Kierownik Szpitala">Kierownik Szpitala</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-warning">Zapisz</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/auth-handler.js" asp-append-version="true"></script>
    <script src="~/js/api-details-handler.js" asp-append-version="true"></script>
    <script>
        const currHospitalId = window.location.pathname.split('/').filter(Boolean).pop();

        window.manageAccountLock = async function(email) {
            if (!confirm("Zmienić status konta dla: " + email + "?")) return;
            const res = await fetch(`/api/Auth/status/${email}`, { headers: { 'Authorization': 'Bearer ' + window.jwtToken } });
            if (!res.ok) return;
            const isLocked = await res.json();
            const actionRes = await fetch(isLocked ? `/api/Auth/unlock/${email}` : `/api/Auth/lock/${email}`, { method: 'POST', headers: { 'Authorization': 'Bearer ' + window.jwtToken } });
            if (actionRes.ok) window.location.reload();
            else alert("Błąd.");
        };

        async function updateStatuses() {
            const spans = document.querySelectorAll('[id^="lock-status-"]');
            for (let s of spans) {
                const email = s.getAttribute('data-email');
                if (!email) continue;
                try {
                    const r = await fetch(`/api/Auth/status/${email}`, { headers: { 'Authorization': 'Bearer ' + window.jwtToken } });
                    if (r.ok) {
                        const locked = await r.json();
                        s.innerHTML = locked ? '<span class="badge bg-danger">Zablokowane</span>' : '<span class="badge bg-success">Aktywne</span>';
                    }
                } catch (e) { s.innerHTML = 'Błąd'; }
            }
        }

        document.addEventListener("DOMContentLoaded", async function () {
            await window.setupDepartmentDetails({
                departmentId: currHospitalId,
                endpoints: { department: '/api/Medical/hospitals', staff: '/api/Medical/paramedics', addStaff: '/api/Medical/paramedics' },
                foreignKeyField: 'hospitalId',
                emptyStaffColspan: 5,
                addStaffFormId: 'addStaffForm',
                onInit: async (decodedToken) => {
                    const roles = window.getUserRoles(decodedToken);
                    if (roles.includes("Admin") || roles.includes("Kierownik Szpitala")) {
                        document.getElementById('btn-open-modal')?.classList.remove('d-none');
                        document.getElementById('admin-hospital-actions')?.classList.remove('d-none');
                    }
                },
                    renderDepartment: (dept) => {
                    document.getElementById('hosp-name').textContent = dept.name || dept.Name;
                    document.getElementById('hosp-address').textContent = dept.address || dept.Address;

                    const hasSor = dept.hasSOR !== undefined ? dept.hasSOR : dept.HasSOR;
                    document.getElementById('hosp-sor').innerHTML = hasSor
                        ? '<span class="badge bg-success">Posiada SOR</span>'
                        : '<span class="badge bg-danger">Brak SOR</span>';

                    const hasHelipad = dept.hasHelipad !== undefined ? dept.hasHelipad : dept.HasHelipad;
                    document.getElementById('hosp-helipad').innerHTML = hasHelipad
                        ? '<span class="badge bg-warning text-dark"><i class="fas fa-h-square"></i> Posiada lądowisko</span>'
                        : '<span class="badge bg-secondary"><i class="fas fa-h-square"></i> Brak lądowiska</span>';

                    document.getElementById('editHospName').value = dept.name || dept.Name;
                    document.getElementById('editHospAddress').value = dept.address || dept.Address;
                    document.getElementById('editHospSor').value = (dept.hasSOR || dept.HasSOR) ? "true" : "false";
                },
                renderStaffRow: (p) => `<tr>
                    <td><img src="${p.avatarUrl || 'https://ui-avatars.com/api/?name=' + (p.name || 'Medyk')}" class="img-circle" style="width:40px;"></td>
                    <td><b>${p.name || ''} ${p.lastName || ''}</b><br><small>${p.rank || 'Medyk'}</small></td>
                    <td>${p.licenseNumber || ''}</td>
                    <td>${p.email || ''}<br/><span id="lock-status-${p.id || p.Id}" data-email="${p.email || p.Email}"><i class="fas fa-spinner fa-spin"></i></span></td>
                    <td class="text-right">
                        <button onclick="window.manageAccountLock('${p.email || p.Email}')" class="btn btn-sm btn-dark"><i class="fas fa-user-lock"></i></button>
                        <button onclick="window.openEditEmpModal('${p.id || p.Id}', '${p.name || ''}', '${p.lastName || ''}', '${p.licenseNumber || ''}', '${p.rank || ''}')" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></button>
                        <button onclick="window.deleteParamedic('${p.id || p.Id}')" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                    </td>
                </tr>`,
                buildStaffPayload: () => ({
                    name: document.getElementById('staffName').value,
                    lastName: document.getElementById('staffLastName').value,
                    email: document.getElementById('staffEmail').value,
                    licenseNumber: document.getElementById('staffLicense').value,
                    specialization: "Brak",
                    rank: document.getElementById('staffRole').value,
                    hospitalId: currHospitalId,
                    paraAccountId: "Auto-Generated"
                })
            });
            setTimeout(updateStatuses, 1000);
        });

        window.deleteParamedic = async (id) => {
            if (!confirm("Zwolnić?")) return;
            const res = await fetch(`/api/Medical/paramedics/${id}`, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + window.jwtToken } });
            if (res.ok) window.location.reload();
        };

        window.openEditEmpModal = (id, n, ln, l, r) => {
            document.getElementById('editEmpId').value = id;
            document.getElementById('editEmpName').value = n;
            document.getElementById('editEmpLastName').value = ln;
            document.getElementById('editEmpLicense').value = l;
            document.getElementById('editEmpRole').value = r;
            $('#editParamedicModal').modal('show');
        };

        document.getElementById('editParamedicForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('editEmpId').value;
            const data = { name: document.getElementById('editEmpName').value, lastName: document.getElementById('editEmpLastName').value, licenseNumber: document.getElementById('editEmpLicense').value, rank: document.getElementById('editEmpRole').value };
            const res = await fetch(`/api/Medical/paramedics/${id}`, { method: 'PUT', headers: { 'Authorization': 'Bearer ' + window.jwtToken, 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
            if (res.ok) window.location.reload();
        });

        document.getElementById('editHospitalForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = { name: document.getElementById('editHospName').value, address: document.getElementById('editHospAddress').value, hasSOR: document.getElementById('editHospSor').value === "true" };
            const res = await fetch(`/api/Medical/hospitals/${currHospitalId}`, { method: 'PUT', headers: { 'Authorization': 'Bearer ' + window.jwtToken, 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
            if (res.ok) window.location.reload();
        });
    </script>
}