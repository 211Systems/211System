@{
    ViewData["Title"] = "Szpitale i Placówki Medyczne";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h1 class="m-0 text-success"><i class="fas fa-hospital"></i> Lista Szpitalów</h1>
        <a href="/Medic/Hospitals/Create" class="btn btn-success"><i class="fas fa-plus"></i> Dodaj Szpital</a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card card-success card-outline">
            <div class="card-header">
                <h3 class="card-title">Zarządzanie siecią medyczną</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 10px">#</th>
                            <th>Nazwa Placówki</th>
                            <th>Adres</th>
                            <th class="text-center">Czy posiada SOR?</th>
                            <th style="width: 150px" class="text-center">Akcje</th>
                        </tr>
                    </thead>
                    <tbody id="hospitals-table-body">
                        <tr>
                            <td colspan="5" class="text-center">Ładowanie danych...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const tableBody = document.getElementById('hospitals-table-body');
            const token = localStorage.getItem('jwt');

            try {
                const response = await fetch('/api/Medical/hospitals', {
                    method: 'GET',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const hospitals = await response.json();
                    tableBody.innerHTML = '';

                    if (hospitals.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="5" class="text-center">Brak placówek w systemie.</td></tr>';
                        return;
                    }

                    hospitals.forEach((hosp, index) => {
                        const sorBadge = hosp.hasSOR || hosp.HasSOR
                            ? '<span class="badge bg-danger">TAK</span>'
                            : '<span class="badge bg-secondary">NIE</span>';

                        const row = `
                            <tr>
                                <td>${index + 1}</td>
                                <td><b>${hosp.name || hosp.Name}</b></td>
                                <td>${hosp.address || hosp.Address}</td>
                                <td class="text-center">${sorBadge}</td>
                                <td class="text-center">
                                    <a href="/Medic/Hospitals/Details/${hosp.id || hosp.Id}" class="btn btn-sm btn-success" title="Szczegóły">
                                        <i class="fas fa-stethoscope"></i> Zarządzaj
                                    </a>
                                </td>
                            </tr>
                        `;
                        tableBody.insertAdjacentHTML('beforeend', row);
                    });
                } else {
                    tableBody.innerHTML = '<tr><td colspan="5" class="text-danger text-center">Błąd autoryzacji lub serwera.</td></tr>';
                }
            } catch (error) {
                tableBody.innerHTML = '<tr><td colspan="5" class="text-danger text-center">Błąd połączenia z API.</td></tr>';
                console.error(error);
            }
        });
    </script>
}