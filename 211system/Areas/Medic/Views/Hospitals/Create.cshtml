@{
    ViewData["Title"] = "Rejestracja Szpitala";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card card-success">
            <div class="card-header">
                <h3 class="card-title">Nowa Placówka Medyczna</h3>
            </div>
            
            <form id="createHospitalForm">
                <div class="card-body">
                    <div class="form-group">
                        <label for="name">Nazwa Szpitala</label>
                        <input type="text" class="form-control" id="name" placeholder="np. Wojewódzki Szpital Zespolony" required>
                    </div>
                    <div class="form-group">
                        <label for="address">Adres</label>
                        <input type="text" class="form-control" id="address" placeholder="np. ul. Medyczna 1" required>
                    </div>
                    <div class="form-group custom-control custom-switch custom-switch-off-danger custom-switch-on-success">
                        <input type="checkbox" class="custom-control-input" id="hasSOR">
                        <label class="custom-control-label" for="hasSOR">Placówka posiada Szpitalny Oddział Ratunkowy (SOR)</label>
                    </div>
                    <div class="form-group mt-3">
                        <label><i class="fas fa-map-marker-alt text-danger"></i> Wybierz lokalizację placówki na mapie</label>
                        <div id="picker-map" style="height: 300px; width: 100%; border-radius: 5px; border: 1px solid #ccc;"></div>
                    </div>

                    <div class="row mt-2 mb-3">
                        <div class="col-md-4">
                            <label><small class="text-muted">Latitude (Z mapy)</small></label>
                            <input type="text" id="deptLat" class="form-control form-control-sm" readonly placeholder="Kliknij na mapie">
                        </div>
                        <div class="col-md-4">
                            <label><small class="text-muted">Longitude (Z mapy)</small></label>
                            <input type="text" id="deptLng" class="form-control form-control-sm" readonly placeholder="Kliknij na mapie">
                        </div>
                        <div class="col-md-4">
                            <label><small class="text-muted">Promień operacyjny (km)</small></label>
                            <input type="number" id="deptRadius" class="form-control form-control-sm" value="15" min="1">
                        </div>
                    </div>
                    <p id="form-error" class="text-danger d-none mt-3"></p>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a href="/Medic/Hospitals" class="btn btn-default">Anuluj</a>
                    <button type="submit" class="btn btn-success">Zarejestruj Szpital</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/api-form-handler.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let pickerMap = L.map('picker-map').setView([52.2297, 21.0122], 11);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(pickerMap);

            let pickerMarker = null;
            let pickerCircle = null;
            const radiusInput = document.getElementById('deptRadius');
            const latInput = document.getElementById('deptLat');
            const lngInput = document.getElementById('deptLng');

            function updateCircle(lat, lng, radiusKm) {
                if (pickerCircle) pickerMap.removeLayer(pickerCircle);
                pickerCircle = L.circle([lat, lng], {
                    color: '#28a745',
                    fillColor: '#28a745',
                    fillOpacity: 0.2,
                    radius: radiusKm * 1000
                }).addTo(pickerMap);
            }

            pickerMap.on('click', function (e) {
                const lat = e.latlng.lat.toFixed(5);
                const lng = e.latlng.lng.toFixed(5);

                latInput.value = lat;
                lngInput.value = lng;

                if (pickerMarker) {
                    pickerMarker.setLatLng(e.latlng);
                } else {
                    pickerMarker = L.marker(e.latlng).addTo(pickerMap);
                }

                updateCircle(lat, lng, radiusInput.value || 15);
            });

            radiusInput.addEventListener('change', function() {
                if (pickerMarker) {
                    const pos = pickerMarker.getLatLng();
                    updateCircle(pos.lat, pos.lng, this.value);
                }
            });

            setTimeout(() => { pickerMap.invalidateSize(); }, 500);

            setupApiFormSubmit({
                formId: 'createHospitalForm',
                apiUrl: '/api/Medical/hospitals',
                redirectUrl: '/Medic/Hospitals',
                defaultErrorMsg: 'Błąd podczas dodawania szpitala.',
                buildPayload: () => {
                    const latVal = latInput.value;
                    const lngVal = lngInput.value;

                    if (!latVal || !lngVal) {
                        alert("Proszę wskazać lokalizację placówki na mapie!");
                        throw new Error("Validation Failed");
                    }

                    return {
                        name: document.getElementById('name').value,
                        address: document.getElementById('address').value,
                        hasSOR: document.getElementById('hasSOR').checked,
                        latitude: parseFloat(latVal),
                        longitude: parseFloat(lngVal),
                        operatingRadiusKm: parseFloat(radiusInput.value)
                    };
                }
            });
        });
    </script>
}