@{
    ViewData["Title"] = "Rejestracja Szpitala";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card card-success">
            <div class="card-header">
                <h3 class="card-title">Nowa Placówka Medyczna</h3>
            </div>

            <form id="createHospitalForm">
                <div class="card-body">
                    <div class="form-group">
                        <label for="name">Nazwa Szpitala</label>
                        <input type="text" class="form-control" id="name" placeholder="np. Wojewódzki Szpital Zespolony" required>
                    </div>
                    <div class="form-group">
                        <label for="address">Adres Placówki</label>
                        <input type="text" class="form-control" id="address" placeholder="np. ul. Medyczna 1" required>
                    </div>

                    <div class="form-group form-check mt-4 mb-2">
                        <input type="checkbox" class="form-check-input" id="hasSOR">
                        <label class="form-check-label font-weight-bold" for="hasSOR">Placówka posiada Szpitalny Oddział Ratunkowy (SOR)</label>
                    </div>
                    <div class="form-group mt-3">
                        <div class="custom-control custom-switch custom-switch-off-danger custom-switch-on-success">
                            <input type="checkbox" class="custom-control-input" id="hasHelipad">
                            <label class="custom-control-label font-weight-bold" for="hasHelipad"><i class="fas fa-h-square text-success"></i> Posiada lądowisko przyszpitalne</label>
                        </div>
                    </div>
                    <div class="form-group mt-4">
                        <label><i class="fas fa-map-marker-alt text-danger"></i> Wybierz lokalizację placówki na mapie</label>
                        <div id="picker-map" style="height: 300px; width: 100%; border-radius: 5px; border: 1px solid #ccc;"></div>
                    </div>

                    <div class="row mt-2 mb-3">
                        <div class="col-md-4">
                            <label><small class="text-muted">Latitude (Z mapy)</small></label>
                            <input type="text" id="deptLat" class="form-control form-control-sm" readonly placeholder="Kliknij na mapie">
                        </div>
                        <div class="col-md-4">
                            <label><small class="text-muted">Longitude (Z mapy)</small></label>
                            <input type="text" id="deptLng" class="form-control form-control-sm" readonly placeholder="Kliknij na mapie">
                        </div>
                        <div class="col-md-4">
                            <label><small class="text-muted">Promień operacyjny (km)</small></label>
                            <input type="number" id="deptRadius" class="form-control form-control-sm" value="15" min="1">
                        </div>
                    </div>

                    <p id="form-error" class="text-danger d-none"></p>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a href="/Admin/Hospitals" class="btn btn-default">Anuluj</a>
                    <button type="submit" class="btn btn-success">Utwórz placówkę</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/auth-handler.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const token = await window.ensureValidToken();
            if (!token) {
                sessionStorage.setItem('returnUrl', window.location.pathname);
                window.location.href = "/AuthView/Login";
                return;
            }

            let pickerMap = L.map('picker-map').setView([52.2297, 21.0122], 11);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(pickerMap);

            let pickerMarker = null;
            let pickerCircle = null;
            const radiusInput = document.getElementById('deptRadius');
            const latInput = document.getElementById('deptLat');
            const lngInput = document.getElementById('deptLng');

            function updateCircle(lat, lng, radiusKm) {
                if (pickerCircle) pickerMap.removeLayer(pickerCircle);
                pickerCircle = L.circle([lat, lng], {
                    color: '#28a745',
                    fillColor: '#28a745',
                    fillOpacity: 0.2,
                    radius: radiusKm * 1000
                }).addTo(pickerMap);
            }

            pickerMap.on('click', function (e) {
                const lat = e.latlng.lat.toFixed(5);
                const lng = e.latlng.lng.toFixed(5);

                latInput.value = lat;
                lngInput.value = lng;

                if (pickerMarker) {
                    pickerMarker.setLatLng(e.latlng);
                } else {
                    pickerMarker = L.marker(e.latlng).addTo(pickerMap);
                }

                updateCircle(lat, lng, radiusInput.value || 15);
            });

            async function loadExistingInfrastructure() {
                const headers = { 'Authorization': 'Bearer ' + token };
                const mapLayer = L.featureGroup().addTo(pickerMap);

                const blueIcon = new L.Icon({ iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png', shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png', iconSize: [20, 32], iconAnchor: [10, 32], popupAnchor: [1, -24] });
                const greenIcon = new L.Icon({ iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png', shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png', iconSize: [20, 32], iconAnchor: [10, 32], popupAnchor: [1, -24] });
                const orangeIcon = new L.Icon({ iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-orange.png', shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png', iconSize: [20, 32], iconAnchor: [10, 32], popupAnchor: [1, -24] });

                try {
                    const [hospRes, polRes, fireRes] = await Promise.all([
                        fetch('/api/Medical/hospitals', { headers }),
                        fetch('/api/Police/departments', { headers }),
                        fetch('/api/Fire/departments', { headers })
                    ]);

                    if (hospRes.ok) {
                        const data = await hospRes.json();
                        data.forEach(d => { if (d.latitude) L.marker([d.latitude, d.longitude], {icon: greenIcon, opacity: 0.7}).bindPopup(d.name).addTo(mapLayer); });
                    }
                    if (polRes.ok) {
                        const data = await polRes.json();
                        data.forEach(d => { if (d.latitude) L.marker([d.latitude, d.longitude], {icon: blueIcon, opacity: 0.7}).bindPopup(d.name).addTo(mapLayer); });
                    }
                    if (fireRes.ok) {
                        const data = await fireRes.json();
                        data.forEach(d => { if (d.latitude) L.marker([d.latitude, d.longitude], {icon: orangeIcon, opacity: 0.7}).bindPopup(d.name).addTo(mapLayer); });
                    }
                } catch(e) { console.error(e); }
            }
            loadExistingInfrastructure();

            radiusInput.addEventListener('change', function() {
                if (pickerMarker) {
                    const pos = pickerMarker.getLatLng();
                    updateCircle(pos.lat, pos.lng, this.value);
                }
            });

            setTimeout(() => { pickerMap.invalidateSize(); }, 500);

            document.getElementById('createHospitalForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                const errorMsg = document.getElementById('form-error');
                errorMsg.classList.add('d-none');

                const latVal = latInput.value;
                const lngVal = lngInput.value;

                if (!latVal || !lngVal) {
                    alert("Proszę wskazać lokalizację placówki na mapie!");
                    return;
                }

                const payload = {
                    name: document.getElementById('name').value,
                    address: document.getElementById('address').value,
                    hasSOR: document.getElementById('hasSOR').checked,
                    hasHelipad: document.getElementById('hasHelipad').checked,
                    latitude: parseFloat(latVal),
                    longitude: parseFloat(lngVal),
                    operatingRadiusKm: parseFloat(radiusInput.value)
                };

                try {
                    const res = await fetch('/api/Medical/hospitals', {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (res.ok) {
                        if (payload.hasHelipad) {
                            await fetch('/api/Aviation/airbases', {
                                method: 'POST',
                                headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    name: `Lądowisko: ${payload.name}`,
                                    icaoCode: "MEDIC",
                                    serviceType: 0,
                                    latitude: payload.latitude,
                                    longitude: payload.longitude
                                })
                            }).catch(err => console.error("Błąd lądowiska:", err));
                        }

                        window.location.href = '/Medic/Hospitals';
                    } else {
                        errorMsg.textContent = "Błąd podczas dodawania szpitala.";
                        errorMsg.classList.remove('d-none');
                    }
                } catch(e) {
                    errorMsg.textContent = "Błąd sieci. Serwer nie odpowiada.";
                    errorMsg.classList.remove('d-none');
                }
            });
        });
    </script>
}