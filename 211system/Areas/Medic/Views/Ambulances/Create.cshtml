@{
    ViewData["Title"] = "Dodaj Karetkę";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card card-success">
            <div class="card-header">
                <h3 class="card-title">Rejestracja Nowego Ambulansu</h3>
            </div>
            
            <form id="createAmbulanceForm">
                <div class="card-body">
                    <div class="form-group">
                        <label for="licensePlate">Numer Rejestracyjny</label>
                        <input type="text" class="form-control" id="licensePlate" placeholder="np. GD 12345" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="type">Typ Ambulansu</label>
                        <select class="form-control" id="type" required>
                            <option value="0">S - Specjalistyczna</option>
                            <option value="1">T - Transportowa</option>
                            <option value="2">P - Podstawowa</option>
                            <option value="3">N - Neonatologiczna (dla noworodków)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="hospitalId">Przypisz do Szpitala</label>
                        <select class="form-control" id="hospitalId" required>
                            <option value="">Wybierz szpital z listy...</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label for="paramedicId">Przypisz Ratownika</label>
                        <select class="form-control" id="paramedicId" required>
                            <option value="">-- Wybierz najpierw szpital --</option>
                        </select>
                    </div>
                    
                    <p id="form-error" class="text-danger d-none mt-3"></p>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a href="/Medic/Ambulances" class="btn btn-default">Anuluj</a>
                    <button type="submit" class="btn btn-success">Zarejestruj Karetkę</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api-form-handler.js"></script>
    <script src="~/js/api-department-loader.js"></script>
    <script>
        const token = localStorage.getItem('jwt');
        let allParamedics = [];

        document.addEventListener("DOMContentLoaded", async function () {

            await loadDepartmentsForDropdown({
                selectElementId: 'hospitalId',
                allowedRoles: ["Admin", "Kierownik Szpitala"],
                fallbackUrl: '/Medic/Ambulances',
                departmentsApiUrl: '/api/Medical/hospitals',
                staffApiUrl: '/api/Medical/paramedics',
                foreignKeyField: 'hospitalId'
            });

            if (token) {
                try {
                    const res = await fetch('/api/Medical/paramedics', { headers: { 'Authorization': 'Bearer ' + token } });
                    if (res.ok) {
                        allParamedics = await res.json();
                    }
                } catch (e) {}
            }

            document.getElementById('hospitalId').addEventListener('change', function () {
                const selectedHospitalId = this.value;
                const paramSelect = document.getElementById('paramedicId');
                
                paramSelect.innerHTML = '<option value="">-- Wybierz ratownika --</option>';

                if (!selectedHospitalId) return;

                const filteredParamedics = allParamedics.filter(p => (p.hospitalId || p.HospitalId) === selectedHospitalId);

                if (filteredParamedics.length === 0) {
                    paramSelect.innerHTML = '<option value="">Brak ratowników w tym szpitalu</option>';
                    return;
                }

                filteredParamedics.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id || p.Id;
                    opt.textContent = `${p.name || p.Name} ${p.lastName || p.LastName}`;
                    paramSelect.appendChild(opt);
                });
            });

            setupApiFormSubmit({
                formId: 'createAmbulanceForm',
                apiUrl: '/api/Medical/ambulances',
                redirectUrl: '/Medic/Ambulances',
                defaultErrorMsg: 'Błąd podczas dodawania karetki.',
                buildPayload: () => {
                    const hospId = document.getElementById('hospitalId').value;
                    const paramId = document.getElementById('paramedicId').value;

                    if (!hospId) {
                        const errorMsg = document.getElementById('form-error');
                        errorMsg.textContent = "Musisz wybrać szpital!";
                        errorMsg.classList.remove('d-none');
                        throw new Error("Validation failed - brak szpitala");
                    }
                    
                    if (!paramId) {
                        const errorMsg = document.getElementById('form-error');
                        errorMsg.textContent = "Musisz przypisać ratownika!";
                        errorMsg.classList.remove('d-none');
                        throw new Error("Validation failed - brak ratownika");
                    }

                    return {
                        licensePlate: document.getElementById('licensePlate').value,
                        type: parseInt(document.getElementById('type').value),
                        hospitalId: hospId,
                        paramedicId: paramId
                    };
                }
            });
        });
    </script>
}