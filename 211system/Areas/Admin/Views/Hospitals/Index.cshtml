@{
    ViewData["Title"] = "Placówki Medyczne";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h1 class="m-0">Lista Szpitali</h1>
        <a href="/Admin/Hospitals/Create" class="btn btn-success"><i class="fas fa-plus"></i> Dodaj nową placówkę</a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-success">
                <h3 class="card-title">Zarządzanie strukturami medycznymi</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 10px">#</th>
                            <th>Nazwa Szpitala</th>
                            <th>Adres</th>
                            <th>Czy posiada SOR?</th>
                            <th style="width: 150px">Akcje</th>
                        </tr>
                    </thead>
                    <tbody id="hospitals-table-body">
                        <tr>
                            <td colspan="5" class="text-center">Ładowanie danych...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const tableBody = document.getElementById('hospitals-table-body');
            const token = localStorage.getItem('jwt');

            try {
                const response = await fetch('/api/Medical/hospitals', {
                    method: 'GET',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const hospitals = await response.json();
                    tableBody.innerHTML = '';

                    if (hospitals.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="5" class="text-center">Brak placówek w systemie.</td></tr>';
                        return;
                    }

                    hospitals.forEach((dept, index) => {
                        const hasSOR = dept.hasSOR !== undefined ? dept.hasSOR : dept.HasSOR;
                        const sorBadge = hasSOR
                            ? '<span class="badge bg-success">TAK</span>'
                            : '<span class="badge bg-danger">NIE</span>';

                        const row = `
                            <tr>
                                <td>${index + 1}</td>
                                <td><b>${dept.name || dept.Name}</b></td>
                                <td>${dept.address || dept.Address}</td>
                                <td>${sorBadge}</td>
                                <td>
                                    <a href="/Admin/Hospitals/Details/${dept.id || dept.Id}" class="btn btn-sm btn-info" title="Szczegóły">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        `;
                        tableBody.insertAdjacentHTML('beforeend', row);
                    });
                } else {
                    tableBody.innerHTML = '<tr><td colspan="5" class="text-danger text-center">Błąd autoryzacji lub serwera.</td></tr>';
                }
            } catch (error) {
                tableBody.innerHTML = '<tr><td colspan="5" class="text-danger text-center">Błąd połączenia z API.</td></tr>';
                console.error(error);
            }
        });
    </script>
}