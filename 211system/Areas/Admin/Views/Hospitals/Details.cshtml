@{
    ViewData["Title"] = "Szczegóły Szpitala";
    var departmentId = ViewBag.HospitalId;
}

<div class="row">
    <div class="col-md-4">
        <div class="card card-success card-outline">
            <div class="card-body box-profile">
                <h3 class="profile-username text-center" id="dept-name">Ładowanie...</h3>
                <p class="text-muted text-center" id="dept-sor">...</p>
                <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item">
                        <b>Adres</b> <a class="float-right" id="dept-address">...</a>
                    </li>
                    <li class="list-group-item">
                        <b>ID Systemowe</b> <a class="float-right text-muted small">@departmentId</a>
                    </li>
                </ul>
                <a href="/Admin/Hospitals" class="btn btn-success btn-block"><b>Powrót do listy</b></a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-info">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title m-0">Personel Przypisany do Szpitala</h3>
                <button type="button" class="btn btn-sm btn-light ml-auto" data-toggle="modal" data-target="#addStaffModal">
                    <i class="fas fa-user-plus"></i> Zatrudnij Medyka
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Specjalizacja</th>
                            <th>Imię i Nazwisko</th>
                            <th>Nr PWZ</th>
                            <th>Email (Login)</th>
                        </tr>
                    </thead>
                    <tbody id="staff-table-body">
                        <tr><td colspan="4" class="text-center">Ładowanie personelu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addStaffModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content dark-mode">
            <div class="modal-header bg-success">
                <h5 class="modal-title">Rejestracja Pracownika Medycznego</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="addStaffForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Imię</label>
                        <input type="text" id="staffName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Nazwisko</label>
                        <input type="text" id="staffSurname" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Email Służbowy (Login)</label>
                        <input type="email" id="staffEmail" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Numer PWZ (Prawo Wykonywania Zawodu)</label>
                        <input type="text" id="staffLicense" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Specjalizacja</label>
                        <input type="text" id="staffSpecialization" class="form-control" placeholder="np. Ratownik, Lekarz SOR" required>
                    </div>
                    
                    <div class="form-group">
                        <label>Hierarchia / Rola w systemie</label>
                        <select id="medicStaffRole" class="form-control" required>
                            <option value="Medyk">Medyk</option>
                            <option value="Lekarz">Lekarz</option>
                            <option value="Kierownik Szpitala">Kierownik Szpitala</option>
                        </select>
                    </div>

                    <div id="generated-password-alert" class="alert alert-warning d-none">
                        <h5><i class="icon fas fa-exclamation-triangle"></i> Konto utworzone!</h5>
                        Przekaż to hasło pracownikowi: <strong id="temp-password-display" style="font-size: 1.2em;"></strong>
                    </div>
                    <p id="staff-error" class="text-danger d-none"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Zamknij</button>
                    <button type="submit" class="btn btn-success" id="btn-submit-staff">Utwórz konto</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api-details-handler.js"></script>
    <script>
        setupDepartmentDetails({
            departmentId: "@departmentId",
            endpoints: {
                department: '/api/Medical/hospitals',
                staff: '/api/Medical/paramedics',
                addStaff: '/api/Medical/paramedics'
            },
            foreignKeyField: 'hospitalId',
            emptyStaffColspan: 4,
            renderDepartment: (dept) => {
                document.getElementById('dept-name').textContent = dept.name || dept.Name;
                document.getElementById('dept-address').textContent = dept.address || dept.Address;
                const hasSOR = dept.hasSOR !== undefined ? dept.hasSOR : dept.HasSOR;
                document.getElementById('dept-sor').innerHTML = hasSOR
                    ? '<span class="badge bg-success">Posiada SOR</span>'
                    : '<span class="badge bg-danger">Brak SOR</span>';
            },
            renderStaffRow: (p) => `<tr>
                <td><span class="badge bg-success">${p.specialization || p.Specialization}</span></td>
                <td>${p.name || p.Name} ${p.lastName || p.LastName}</td>
                <td>${p.licenseNumber || p.LicenseNumber}</td>
                <td>${p.email || p.Email}</td>
            </tr>`,
            buildStaffPayload: () => ({
                name: document.getElementById('staffName').value,
                lastName: document.getElementById('staffSurname').value,
                email: document.getElementById('staffEmail').value,
                licenseNumber: document.getElementById('staffLicense').value,
                specialization: document.getElementById('staffSpecialization').value,
                rank: document.getElementById('medicStaffRole').value,
                hospitalId: "@departmentId",
                paraAccountId: "Auto-Generated"
            })
        });
    </script>
}