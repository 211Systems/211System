@{
    ViewData["Title"] = "Dodaj Jednostkę Straży";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card card-danger">
            <div class="card-header">
                <h3 class="card-title">Rejestracja nowej remizy / JRG</h3>
            </div>

            <form id="createFireStationForm">
                <div class="card-body">
                    <div class="form-group">
                        <label for="name">Nazwa Jednostki</label>
                        <input type="text" class="form-control" id="name" placeholder="np. JRG nr 1" required>
                    </div>
                    <div class="form-group">
                        <label for="address">Adres Placówki</label>
                        <input type="text" class="form-control" id="address" placeholder="np. ul. Strażacka 998" required>
                    </div>
                    <div class="form-group">
                        <label for="district">Dzielnica / Obszar działań</label>
                        <input type="text" class="form-control" id="district" placeholder="np. Śródmieście" required>
                    </div>

                    <p id="form-error" class="text-danger d-none"></p>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a href="/Admin/FireStations" class="btn btn-default">Anuluj</a>
                    <button type="submit" class="btn btn-danger">Utwórz jednostkę</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('createFireStationForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const token = localStorage.getItem('jwt');
            const errorMsg = document.getElementById('form-error');

            const requestData = {
                name: document.getElementById('name').value,
                address: document.getElementById('address').value,
                district: document.getElementById('district').value
            };

            try {
                const response = await fetch('/api/Fire/departments', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(requestData)
                });

                if (response.ok) {
                    window.location.href = '/Admin/FireStations';
                } else {
                    const errorData = await response.json();
                    errorMsg.textContent = errorData.message || "Błąd podczas dodawania jednostki.";
                    errorMsg.classList.remove('d-none');
                }
            } catch (error) {
                errorMsg.textContent = "Błąd połączenia z serwerem.";
                errorMsg.classList.remove('d-none');
                console.error(error);
            }
        });
    </script>
}