@{
    ViewData["Title"] = "Jednostki Straży Pożarnej";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h1 class="m-0">Lista Remiz i JRG</h1>
        <a href="/Admin/FireStations/Create" class="btn btn-danger"><i class="fas fa-plus"></i> Dodaj nową jednostkę</a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-danger">
                <h3 class="card-title">Zarządzanie strukturami straży pożarnej</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 10px">#</th>
                            <th>Nazwa Jednostki</th>
                            <th>Adres</th>
                            <th>Dzielnica / Rejon</th>
                            <th style="width: 150px">Akcje</th>
                        </tr>
                    </thead>
                    <tbody id="firestations-table-body">
                        <tr>
                            <td colspan="5" class="text-center">Ładowanie danych...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const tableBody = document.getElementById('firestations-table-body');
            const token = localStorage.getItem('jwt');

            try {
                const response = await fetch('/api/Fire/departments', {
                    method: 'GET',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const departments = await response.json();
                    tableBody.innerHTML = '';

                    if (departments.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="5" class="text-center">Brak jednostek w systemie.</td></tr>';
                        return;
                    }

                    departments.forEach((dept, index) => {
                        const row = `
                            <tr>
                                <td>${index + 1}</td>
                                <td><b>${dept.name || dept.Name}</b></td>
                                <td>${dept.address || dept.Address}</td>
                                <td><span class="badge bg-warning">${dept.district || dept.District}</span></td>
                                <td>
                                    <a href="/Admin/FireStations/Details/${dept.id || dept.Id}" class="btn btn-sm btn-info" title="Szczegóły">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        `;
                        tableBody.insertAdjacentHTML('beforeend', row);
                    });
                } else {
                    tableBody.innerHTML = '<tr><td colspan="5" class="text-danger text-center">Błąd autoryzacji lub serwera.</td></tr>';
                }
            } catch (error) {
                tableBody.innerHTML = '<tr><td colspan="5" class="text-danger text-center">Błąd połączenia z API.</td></tr>';
                console.error(error);
            }
        });
    </script>
}