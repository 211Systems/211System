@{
    ViewData["Title"] = "Szczegóły Centrum CPR";
    var departmentId = ViewBag.CprCenterId;
}

<div class="row">
    <div class="col-md-4">
        <div class="card card-warning card-outline">
            <div class="card-body box-profile">
                <h3 class="profile-username text-center" id="dept-name">Ładowanie...</h3>
                <p class="text-muted text-center" id="dept-region">...</p>
                <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item">
                        <b>ID Systemowe</b> <a class="float-right text-muted small">@departmentId</a>
                    </li>
                </ul>
                <a href="/Admin/CprCenters" class="btn btn-warning btn-block font-weight-bold"><b>Powrót do listy</b></a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-dark">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title m-0">Operatorzy Numeru 112</h3>
                <button type="button" class="btn btn-sm btn-warning ml-auto font-weight-bold" data-toggle="modal" data-target="#addStaffModal">
                    <i class="fas fa-user-plus"></i> Dodaj Operatora
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Stanowisko</th>
                            <th>Imię i Nazwisko</th>
                            <th>Email (Login)</th>
                        </tr>
                    </thead>
                    <tbody id="staff-table-body">
                        <tr><td colspan="3" class="text-center">Ładowanie personelu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addStaffModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content dark-mode">
            <div class="modal-header bg-warning">
                <h5 class="modal-title font-weight-bold">Rejestracja Operatora 112</h5>
                <button type="button" class="close text-dark" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="addStaffForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Imię</label>
                        <input type="text" id="staffName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Nazwisko</label>
                        <input type="text" id="staffSurname" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Email Służbowy</label>
                        <input type="email" id="staffEmail" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Numer Stanowiska</label>
                        <input type="text" id="staffStation" class="form-control" placeholder="np. ST-01" required>
                    </div>

                    <div id="generated-password-alert" class="alert alert-warning d-none">
                        <h5><i class="icon fas fa-exclamation-triangle"></i> Konto utworzone!</h5>
                        Przekaż to hasło pracownikowi: <strong id="temp-password-display" style="font-size: 1.2em;"></strong>
                    </div>
                    <p id="staff-error" class="text-danger d-none"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Zamknij</button>
                    <button type="submit" class="btn btn-warning font-weight-bold" id="btn-submit-staff">Utwórz konto</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api-details-handler.js"></script>
    <script>
        setupDepartmentDetails({
            departmentId: "@departmentId",
            endpoints: {
                department: '/api/Enc',
                staff: '/api/Operators',
                addStaff: '/api/Operators'
            },
            foreignKeyField: 'encId',
            emptyStaffColspan: 3,
            renderDepartment: (dept) => {
                document.getElementById('dept-name').textContent = dept.name || dept.Name;
                document.getElementById('dept-region').textContent = dept.region || dept.Region;
            },
            renderStaffRow: (p) => `<tr>
                <td><span class="badge bg-warning text-dark">${p.stationNumber || p.StationNumber}</span></td>
                <td>${p.firstName || p.FirstName} ${p.lastName || p.LastName}</td>
                <td>${p.email || p.Email}</td>
            </tr>`,
            buildStaffPayload: () => {
                const tempPassword = "Temp!" + Math.floor(1000 + Math.random() * 9000);
                return {
                    firstName: document.getElementById('staffName').value,
                    lastName: document.getElementById('staffSurname').value,
                    email: document.getElementById('staffEmail').value,
                    stationNumber: document.getElementById('staffStation').value,
                    encId: "@departmentId",
                    password: tempPassword
                };
            }
        });
    </script>
}