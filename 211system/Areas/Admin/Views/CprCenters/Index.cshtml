@{
    ViewData["Title"] = "Centra Powiadamiania Ratunkowego";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h1 class="m-0">Lista Centrów CPR 112</h1>
        <a href="/Admin/CprCenters/Create" class="btn btn-warning"><i class="fas fa-plus"></i> Dodaj nowe centrum</a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-warning">
                <h3 class="card-title">Zarządzanie strukturami 112</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 10px">#</th>
                            <th>Nazwa Centrum CPR</th>
                            <th>Region (Województwo)</th>
                            <th style="width: 150px">Akcje</th>
                        </tr>
                    </thead>
                    <tbody id="cpr-table-body">
                        <tr>
                            <td colspan="4" class="text-center">Ładowanie danych...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const tableBody = document.getElementById('cpr-table-body');
            const token = localStorage.getItem('jwt');

            try {
                const response = await fetch('/api/Cpr', {
                    method: 'GET',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const centers = await response.json();
                    tableBody.innerHTML = '';

                    if (centers.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="4" class="text-center">Brak centrów w systemie.</td></tr>';
                        return;
                    }

                    centers.forEach((center, index) => {
                        const row = `
                            <tr>
                                <td>${index + 1}</td>
                                <td><b>${center.name || center.Name}</b></td>
                                <td><span class="badge bg-secondary">${center.region || center.Region}</span></td>
                                <td>
                                    <a href="/Admin/CprCenters/Details/${center.id || center.Id}" class="btn btn-sm btn-info" title="Szczegóły">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        `;
                        tableBody.insertAdjacentHTML('beforeend', row);
                    });
                } else {
                    tableBody.innerHTML = '<tr><td colspan="4" class="text-danger text-center">Błąd autoryzacji lub serwera.</td></tr>';
                }
            } catch (error) {
                tableBody.innerHTML = '<tr><td colspan="4" class="text-danger text-center">Błąd połączenia z API.</td></tr>';
                console.error(error);
            }
        });
    </script>
}