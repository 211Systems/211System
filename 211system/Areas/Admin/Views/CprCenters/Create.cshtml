@{
    ViewData["Title"] = "Dodaj Centrum CPR";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Rejestracja nowego Centrum Powiadamiania Ratunkowego</h3>
            </div>

            <form id="createCprForm">
                <div class="card-body">
                    <div class="form-group">
                        <label for="name">Nazwa Centrum</label>
                        <input type="text" class="form-control" id="name" placeholder="np. CPR Białystok" required>
                    </div>
                    <div class="form-group">
                        <label for="region">Region / Województwo</label>
                        <input type="text" class="form-control" id="region" placeholder="np. Podlaskie" required>
                    </div>

                    <p id="form-error" class="text-danger d-none"></p>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a href="/Admin/CprCenters" class="btn btn-default">Anuluj</a>
                    <button type="submit" class="btn btn-warning font-weight-bold">Utwórz centrum</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('createCprForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const token = localStorage.getItem('jwt');
            const errorMsg = document.getElementById('form-error');

            const requestData = {
                name: document.getElementById('name').value,
                region: document.getElementById('region').value
            };

            try {
                const response = await fetch('/api/Cpr', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(requestData)
                });

                if (response.ok) {
                    window.location.href = '/Admin/CprCenters';
                } else {
                    const errorData = await response.json();
                    errorMsg.textContent = errorData.message || "Błąd podczas dodawania centrum.";
                    errorMsg.classList.remove('d-none');
                }
            } catch (error) {
                errorMsg.textContent = "Błąd połączenia z serwerem.";
                errorMsg.classList.remove('d-none');
                console.error(error);
            }
        });
    </script>
}