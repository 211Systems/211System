@{
    ViewData["Title"] = "Dodaj Komendę";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card card-success">
            <div class="card-header">
                <h3 class="card-title">Rejestracja nowej jednostki policyjnej</h3>
            </div>

            <form id="createDepartmentForm">
                <div class="card-body">
                    <div class="form-group">
                        <label for="name">Nazwa Komendy</label>
                        <input type="text" class="form-control" id="name" placeholder="np. Komenda Główna Policji" required>
                    </div>
                    <div class="form-group">
                        <label for="address">Adres Placówki</label>
                        <input type="text" class="form-control" id="address" placeholder="np. ul. Puławska 148/150" required>
                    </div>
                    <div class="form-group">
                        <label for="district">Dzielnica / Obszar działań</label>
                        <input type="text" class="form-control" id="district" placeholder="np. Mokotów" required>
                    </div>

                    <p id="form-error" class="text-danger d-none"></p>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a href="/Admin/PoliceStations" class="btn btn-default">Anuluj</a>
                    <button type="submit" class="btn btn-success">Utwórz placówkę</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api-form-handler.js"></script>
    <script>
        setupApiFormSubmit({
            formId: 'createDepartmentForm',
            apiUrl: '/api/Police/departments',
            redirectUrl: '/Admin/PoliceStations',
            defaultErrorMsg: 'Błąd podczas dodawania komendy.',
            buildPayload: () => ({
                name: document.getElementById('name').value,
                address: document.getElementById('address').value,
                district: document.getElementById('district').value
            })
        });
    </script>
}