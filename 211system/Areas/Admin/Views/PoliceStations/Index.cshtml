@{
    ViewData["Title"] = "Departamenty Policji";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h1 class="m-0">Lista Komend</h1>
        <a href="/Admin/PoliceStations/Create" class="btn btn-success"><i class="fas fa-plus"></i> Dodaj nową placówkę</a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary">
                <h3 class="card-title">Zarządzanie strukturami policji</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 10px">#</th>
                            <th>Nazwa Komendy</th>
                            <th>Adres</th>
                            <th>Dzielnica / Rejon</th>
                            <th style="width: 150px">Akcje</th>
                        </tr>
                    </thead>
                    <tbody id="departments-table-body">
                        <tr>
                            <td colspan="5" class="text-center">Ładowanie danych...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api-list-handler.js"></script>
    <script>
        setupApiList({
            tableBodyId: 'departments-table-body',
            apiUrl: '/api/Police/departments',
            colspan: 5,
            emptyMessage: 'Brak placówek w systemie.',
            renderRow: (dept, index) => `
                <tr>
                    <td>${index + 1}</td>
                    <td><b>${dept.name || dept.Name}</b></td>
                    <td>${dept.address || dept.Address}</td>
                    <td><span class="badge bg-warning">${dept.district || dept.District}</span></td>
                    <td>
                        <a href="/Admin/PoliceStations/Details/${dept.id || dept.Id}" class="btn btn-sm btn-info" title="Szczegóły">
                            <i class="fas fa-eye"></i>
                        </a>
                    </td>
                </tr>
            `
        });
    </script>
}