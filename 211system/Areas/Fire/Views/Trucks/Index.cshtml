@{
    ViewData["Title"] = "Zarządzanie Flotą Wozów Strażackich";
}

@{
    ViewBag.Title = "Rejestr Wozów Strażackich";
    ViewBag.Icon = "fas fa-truck-moving";
    ViewBag.AddButtonText = "Zarejestruj Wóz";
    ViewBag.AddButtonLink = "/Fire/Trucks/Create";
    ViewBag.TableBodyId = "fire-trucks-table-body";
    ViewBag.ThemeColor = "danger";
}
@await Html.PartialAsync("~/Views/Shared/_VehicleListPartial.cshtml")

@section Scripts {
    <script>
            document.addEventListener("DOMContentLoaded", async function () {
                const token = localStorage.getItem('jwt');
                const tableBody = document.getElementById('fire-trucks-table-body');
    
                if (!tableBody) {
                    console.error("Nie znaleziono elementu tabeli. Sprawdź, czy Partial view ładuje się poprawnie.");
                    return;
                }
    
                try {
                    const res = await fetch('/api/Fire/trucks', { headers: { 'Authorization': 'Bearer ' + token } });
                    const trucks = await res.json();
                    tableBody.innerHTML = '';
                    
                    if (trucks.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="6" class="text-center">Brak wozów strażackich w systemie.</td></tr>';
                        return;
                    }

                    trucks.forEach((v, index) => {
                        const plate = v.licensePlate || v.LicensePlate || "Brak Tablicy";
                        const isAvailable = v.isAvailable !== undefined ? v.isAvailable : (v.IsAvailable !== undefined ? v.IsAvailable : true);
                        const statusBadge = isAvailable
                            ? '<span class="badge badge-success">Dostępny</span>'
                            : '<span class="badge badge-danger">W Akcji / Zajęty</span>';

                        tableBody.insertAdjacentHTML('beforeend', `
                            <tr>
                                <td>${index + 1}</td>
                                <td><b>${plate}</b></td>
                                <td><span class="badge badge-secondary">Wóz Bojowy</span></td>
                                <td><i class="fas fa-building text-muted"></i> Remiza</td>
                                <td>${statusBadge}</td>
                                <td class="text-right">
                                    <button onclick="deleteGlobalTruck('${v.id || v.Id}')" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                        `);
                    });
                }
            } catch (e) {
                tableBody.innerHTML = '<tr><td colspan="6" class="text-center text-danger">Błąd ładowania z serwera.</td></tr>';
            }
        });

        window.deleteGlobalTruck = async function(id) {
            if (!confirm("Na pewno usunąć ten pojazd z globalnego rejestru?")) return;
            const token = localStorage.getItem('jwt');
            await fetch(`/api/Fire/trucks/${id}`, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token } });
            location.reload();
        };
    </script>
}