@{
    ViewData["Title"] = "Remizy Strażackie";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h1 class="m-0 text-danger"><i class="fas fa-fire-extinguisher"></i> Lista Remiz</h1>
    </div>
</div>
@{
    ViewBag.ThemeColor = "danger";
    ViewBag.Icon = "fas fa-fire";
    ViewBag.Title = "Zarządzanie jednostkami straży pożarnej";
    ViewBag.AddButtonText = "Dodaj Remizę";
    ViewBag.AddLink = "/Fire/Home/Create";
    ViewBag.TableBodyId = "departments-table-body";
    ViewBag.Col4Name = "Region / Rejon";
}
@await Html.PartialAsync("~/Views/Shared/_DepartmentListPartial.cshtml")

@section Scripts {
    <script src="~/js/api-custom-list-handler.js"></script>
    <script>
        window.parseJwt = window.parseJwt || function (token) {
            try { return JSON.parse(window.atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))); } catch (e) { return null; }
        };

        document.addEventListener("DOMContentLoaded", function () {
            const token = localStorage.getItem('jwt');
            if (token) {
                const decoded = window.parseJwt(token);
                if (decoded) {
                    let roleClaim = decoded["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || decoded.role;
                    let roles = Array.isArray(roleClaim) ? roleClaim : [roleClaim];
                    if (roles.includes("Admin") || roles.includes("Naczelnik")) {
                        document.getElementById('btn-add-dept').classList.remove('d-none');
                    }
                }
            }
        });

        setupCustomList({
            tableBodyId: 'departments-table-body',
            colspan: 5,
            emptyMessage: 'Brak przypisanych remiz w systemie.',
            loadData: async (jwt) => {
                const decoded = window.parseJwt(jwt);
                let roles = [];
                let email = "";
                if (decoded) {
                    let roleClaim = decoded["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || decoded.role;
                    roles = Array.isArray(roleClaim) ? roleClaim : [roleClaim];
                    email = decoded["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"] || decoded.email || "";
                }

                const response = await fetch('/api/Fire/departments', { headers: { 'Authorization': 'Bearer ' + jwt } });
                if (!response.ok) throw new Error("Błąd pobierania placówek");
                let depts = await response.json();

                if (!roles.includes("Admin") && !roles.includes("Naczelnik")) {
                    const paramResponse = await fetch('/api/Fire/firemen', { headers: { 'Authorization': 'Bearer ' + jwt } });
                    if (paramResponse.ok) {
                        const staff = await paramResponse.json();
                        const myRecord = staff.find(p => p.email === email || p.Email === email);

                        if (myRecord) {
                            const myDeptId = myRecord.fDepartmentId || myRecord.FDepartmentId;
                            depts = depts.filter(h => (h.id || h.Id) === myDeptId);

                            if (depts.length === 1) {
                                window.location.href = `/Fire/Home/Details/${myDeptId}`;
                                return null;
                            }
                        } else {
                            depts = [];
                        }
                    }
                }
                return depts;
            },
            renderRow: (dept, index) => {
                return `
                    <tr>
                        <td>${index + 1}</td>
                        <td><b>${dept.name || dept.Name}</b></td>
                        <td>${dept.address || dept.Address}</td>
                        <td>${dept.region || dept.Region || "Brak danych"}</td>
                        <td class="text-center">
                            <a href="/Fire/Home/Details/${dept.id || dept.Id}" class="btn btn-sm btn-danger" title="Szczegóły">
                                <i class="fas fa-fire"></i> Zarządzaj
                            </a>
                        </td>
                    </tr>
                `;
            }
        });
    </script>
}