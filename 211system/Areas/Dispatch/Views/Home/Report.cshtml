@{
    ViewData["Title"] = "Panel Raportowy 112";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap4.min.css">

<div class="sys-page-header row align-items-center mt-2 mb-3">
    <div class="col">
        <h2 class="sys-page-title m-0"><i class="fas fa-chart-bar text-warning mr-2"></i> Panel Raportowy 112</h2>
        <p class="sys-page-subtitle m-0">Generator raportów PDF i podgląd zdarzeń z okresu</p>
    </div>
    <div class="col-auto">
        <span class="badge badge-dark p-2 live-clock" style="font-size: 1rem;">00:00:00</span>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card card-outline card-warning shadow-lg dark-mode sys-card">
            <div class="card-header border-0">
                <h3 class="card-title text-bold"><i class="fas fa-chart-bar mr-2 text-warning"></i> Generator Raportów i Statystyk</h3>
            </div>

            <div class="card-body">
                <div class="row mb-4 bg-dark p-3 rounded align-items-end border border-secondary shadow-sm">
                    <div class="col-md-3">
                        <label class="text-muted"><i class="far fa-calendar-alt"></i> Data Od:</label>
                        <input type="date" id="dateFrom" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="text-muted"><i class="far fa-calendar-check"></i> Data Do:</label>
                        <input type="date" id="dateTo" class="form-control" />
                    </div>
                    <div class="col-md-6 text-right">
                        <button id="btnLoadData" class="btn btn-warning font-weight-bold mr-2 shadow-sm">
                            <i class="fas fa-search"></i> Pokaż w Tabeli
                        </button>
                        <button id="btnDownloadPdf" class="btn btn-danger font-weight-bold shadow-sm">
                            <i class="fas fa-file-pdf"></i> Pobierz Oficjalny PDF
                        </button>
                    </div>
                </div>

                <div class="table-responsive mt-3">
                    <table id="reportsTable" class="table table-striped table-hover w-100 table-valign-middle">
                        <thead class="bg-secondary">
                            <tr>
                                <th>Numer</th>
                                <th>Data</th>
                                <th>Typ</th>
                                <th>Status</th>
                                <th>Lokalizacja</th>
                                <th>Służby (Zastępy)</th>
                                <th>Opis</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

    <script>
        $(document).ready(function () {
            const table = $('#reportsTable').DataTable({
                dom: '<"row mb-3"<"col-md-6"B><"col-md-6 text-right"f>>rt<"row"<"col-md-6"i><"col-md-6"p>>',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fas fa-file-excel mr-1"></i> Pobierz plik Excel (.xlsx)',
                        className: 'btn btn-success font-weight-bold',
                        title: 'Raport_112_' + new Date().toISOString().slice(0,10)
                    }
                ],
               columns: [
                    { data: 'incidentNumber' },
                    { data: 'date' },
                    { data: 'type' },
                    { data: 'status' },
                    { data: 'address' },
                    { data: 'services' },
                    { data: 'description' }
                ],
                            language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/pl.json' }
            });

            $('#btnLoadData').click(async function() {
                const from = $('#dateFrom').val();
                const to = $('#dateTo').val();
                if(!from || !to) { alert("Wybierz daty!"); return; }

                const response = await fetch(`/api/Reports/data?from=${from}&to=${to}`, {
                    headers: { 'Authorization': 'Bearer ' + window.jwtToken }
                });
                if (!response.ok) {
                    alert("Nie udało się pobrać danych (brak uprawnień lub błąd serwera).");
                    return;
                }
                const data = await response.json();
                table.clear().rows.add(data).draw();
            });

            $('#btnDownloadPdf').click(async function() {
                const from = $('#dateFrom').val();
                const to = $('#dateTo').val();
                if(!from || !to) { alert("Wybierz daty!"); return; }
                try {
                    const res = await fetch(`/api/Reports/generate?from=${from}&to=${to}`, {
                        headers: { 'Authorization': 'Bearer ' + window.jwtToken }
                    });
                    if (!res.ok) {
                        alert("Nie udało się wygenerować raportu (brak uprawnień lub błąd serwera).");
                        return;
                    }
                    const blob = await res.blob();
                    const url = window.URL.createObjectURL(blob);
                    window.open(url, '_blank');
                    setTimeout(() => window.URL.revokeObjectURL(url), 15000);
                } catch (e) {
                    alert("Błąd sieci podczas pobierania raportu.");
                }
            });
        });
    </script>
}