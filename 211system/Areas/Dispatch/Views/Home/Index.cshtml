@{
    ViewData["Title"] = "Centrum Powiadamiania Ratunkowego 112";
}

<div class="card card-dark shadow mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title m-0"><i class="fas fa-map-marked-alt"></i> Mapa Operacyjna</h3>
        <div>
            <button class="btn btn-sm btn-outline-light" onclick="window.refreshMapData()"><i class="fas fa-sync-alt"></i> Odśwież Mapę</button>
        </div>
    </div>
    <div class="card-body p-0">
        <div id="map" style="height: 450px; width: 100%; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;"></div>
    </div>
</div>

<div id="incidents-panel" class="fade-panel">
    <div class="row mb-3" id="status-board">
        <div class="col-md-3 col-6 mb-2">
            <div class="info-box bg-primary shadow status-tile" onclick="window.openDispatchModal('police')">
                <span class="info-box-icon"><i class="fas fa-car-side"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Policja</span>
                    <span class="info-box-number" id="status-police">Ładowanie...</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-2">
            <div class="info-box bg-success shadow status-tile" onclick="window.openDispatchModal('medic')">
                <span class="info-box-icon"><i class="fas fa-ambulance"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Karetki</span>
                    <span class="info-box-number" id="status-medic">Ładowanie...</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-2">
            <div class="info-box bg-danger shadow status-tile" onclick="window.openDispatchModal('fire')">
                <span class="info-box-icon"><i class="fas fa-fire-extinguisher"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Straż PSP</span>
                    <span class="info-box-number" id="status-fire">Ładowanie...</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-2">
            <div class="info-box bg-dark shadow status-tile border border-secondary" onclick="window.openDispatchModal('aviation')">
                <span class="info-box-icon"><i class="fas fa-helicopter text-white"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text text-white">Lotnictwo</span>
                    <span class="info-box-number text-white" id="status-aviation">Ładowanie...</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card card-danger shadow">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-phone-slash"></i> Nowe Zgłoszenie 112</h3>
                </div>
                <form id="createIncidentForm">
                    <div class="card-body">
                        <div class="form-group">
                            <label>Opis Zdarzenia</label>
                            <textarea id="incDescription" class="form-control" rows="3" placeholder="Co się dzieje?..." required></textarea>
                        </div>
                        <div class="form-group">
                            <label>Typ Zdarzenia</label>
                            <select id="incType" class="form-control" required>
                                <option value="">Wybierz typ (Ładowanie...)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Priorytet</label>
                            <select id="incSeverity" class="form-control" required>
                                <option value="3">Wysoki</option>
                                <option value="2">Średni</option>
                                <option value="1">Niski</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-camera"></i> Zdjęcie (opcjonalnie)</label>
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="incPhoto" accept="image/*">
                                    <label class="custom-file-label" for="incPhoto" id="incPhotoLabel">Wybierz plik...</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="row">
                            <div class="col-6">
                                <label><small class="text-muted">Latitude (Z mapy)</small></label>
                                <input type="text" id="incLat" class="form-control form-control-sm" readonly placeholder="Kliknij na mapie">
                            </div>
                            <div class="col-6">
                                <label><small class="text-muted">Longitude (Z mapy)</small></label>
                                <input type="text" id="incLng" class="form-control form-control-sm" readonly placeholder="Kliknij na mapie">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-danger btn-block font-weight-bold" id="btn-submit-incident">
                            <i class="fas fa-plus"></i> Rejestruj Incydent
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card card-dark shadow">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title m-0"><i class="fas fa-list-ul"></i> Aktywne Interwencje</h3>
                    <div>
                        <button class="btn btn-sm btn-warning text-dark mr-2" onclick="window.autoDispatchAI()"><i class="fas fa-magic"></i> Auto-Dyspozycja AI</button>
                    </div>
                </div>
                <div class="bg-dark p-2 border-bottom border-secondary d-flex flex-wrap gap-2 mb-2" id="stats-summary" style="gap: 10px;">
                </div>
                <div class="card-body p-0 table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-striped table-hover m-0 table-valign-middle">
                        <thead class="bg-secondary">
                            <tr>
                                <th style="width: 15%">Numer</th>
                                <th style="width: 25%">Opis</th>
                                <th style="width: 15%">Typ</th>
                                <th style="width: 10%">Priorytet</th>
                                <th style="width: 10%">Status</th>
                                <th style="width: 25%" class="text-right">Akcje</th>
                            </tr>
                        </thead>
                        <tbody id="incidents-table-body">
                            <tr><td colspan="6" class="text-center p-4">Inicjalizacja systemu...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="operators-panel" class="d-none fade-panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning font-weight-bold m-0"><i class="fas fa-users-cog mr-2"></i> Panel Zarządzania Kadrami 112</h2>
        <button class="btn btn-outline-light" onclick="window.location.hash='';"><i class="fas fa-arrow-left"></i> Powrót do Operacji</button>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card card-outline card-warning mb-4 shadow">
                <div class="card-header">
                    <h3 class="card-title text-bold">Rejestracja nowego Operatora/Admina</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3"><label>Imię</label><input type="text" id="regFirstName" class="form-control" placeholder="Imię"></div>
                        <div class="col-md-3"><label>Nazwisko</label><input type="text" id="regLastName" class="form-control" placeholder="Nazwisko"></div>
                        <div class="col-md-2"><label>Stacja</label><input type="text" id="regStation" class="form-control" placeholder="np. S-1"></div>
                        <div class="col-md-4"><label>Adres E-mail</label><input type="email" id="regEmail" class="form-control" placeholder="login@system.pl"></div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label>Ranga Systemowa</label>
                            <select id="regRank" class="form-control">
                                <option value="Dyspozytor112">Dyspozytor 112</option>
                                <option value="Admin112">Administrator 112</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label>Placówka Nadrzędna</label>
                            <select id="regEncId" class="form-control">
                                <option value="">Ładowanie...</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-right">
                    <button onclick="window.registerNewOperator()" class="btn btn-warning text-bold shadow-sm">
                        <i class="fas fa-user-plus"></i> Utwórz konto i wyślij hasło
                    </button>
                </div>
            </div>

            <div class="card card-dark shadow">
                <div class="card-header border-0">
                    <h3 class="card-title m-0"><i class="fas fa-id-badge"></i> Aktywny personel CPR</h3>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-valign-middle m-0">
                        <thead>
                            <tr>
                                <th>Operator</th>
                                <th>Uprawnienia</th>
                                <th>Numer Stanowiska</th>
                                <th>Email i Status</th>
                                <th class="text-right">Zarządzanie</th>
                            </tr>
                        </thead>
                        <tbody id="operators-table-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="unlockedAccountModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content dark-mode border-info">
            <div class="modal-header bg-info">
                <h5 class="modal-title"><i class="fas fa-lock-open"></i> Konto odblokowane!</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Zamknij">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <p>Konto zostało pomyślnie zresetowane i odblokowane.</p>
                <p>Przekaż pracownikowi to nowe, tymczasowe hasło:</p>
                <h2 class="text-warning font-weight-bold my-4" id="new-password-display"></h2>
                <p class="text-muted small">Ze względów bezpieczeństwa hasło wyświetla się tylko raz. <br />Zapisz je przed zamknięciem okna.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Zamknij</button>
            </div>
        </div>
    </div>
</div>

<div id="centers-panel" class="d-none fade-panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning font-weight-bold m-0"><i class="fas fa-hospital mr-2"></i> Zarządzanie Placówkami CPR</h2>
        <button class="btn btn-outline-light" onclick="window.location.hash='';"><i class="fas fa-arrow-left"></i> Wróć do operacji</button>
    </div>
    <div class="row">
        <div class="col-md-5">
            <div class="card card-outline card-warning shadow">
                <div class="card-header"><h3 class="card-title text-bold">Nowa Placówka</h3></div>
                <form id="createCenterForm">
                    <div class="card-body">
                        <div class="form-group">
                            <label>Nazwa placówki</label>
                            <input type="text" id="centerName" class="form-control" placeholder="np. CPR Warszawa" required>
                        </div>
                        <div class="form-group">
                            <label>Region / Lokalizacja</label>
                            <input type="text" id="centerRegion" class="form-control" placeholder="np. Mazowieckie" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <label><small class="text-muted">Latitude (Z mapy)</small></label>
                            <input type="text" id="centerLat" class="form-control form-control-sm" readonly placeholder="Kliknij na mapie">
                        </div>
                        <div class="col-6">
                            <label><small class="text-muted">Longitude (Z mapy)</small></label>
                            <input type="text" id="centerLng" class="form-control form-control-sm" readonly placeholder="Kliknij na mapie">
                        </div>
                    </div>
                    <div class="form-group mt-2">
                        <label>Promień działania (KM)</label>
                        <input type="number" id="centerRadius" class="form-control" value="15" required>
                    </div>
                    <div class="form-group mt-2">
                        <label>Typ Placówki</label>
                        <select id="centerType" class="form-control" onchange="toggleHelipadOptions()">
                            <option value="Hospital">Szpital (Medyczna)</option>
                            <option value="Police">Komenda Policji</option>
                            <option value="Fire">Remiza Straży Pożarnej</option>
                            <option value="Airbase">Baza Lotnicza (HEMS/Policja/Straż)</option>
                        </select>
                    </div>

                    <div class="form-group mt-2" id="helipadOptionGroup">
                        <div class="custom-control custom-switch">
                            <input type="checkbox" class="custom-control-input" id="hasHelipad">
                            <label class="custom-control-label" for="hasHelipad">Posiada lądowisko dla śmigłowców</label>
                        </div>
                    </div>

                    <div id="airbaseOptionGroup" class="d-none border p-2 rounded bg-dark">
                        <div class="form-group">
                            <label>Kod lotniska (ICAO - np. EPWA, EPBC)</label>
                            <input type="text" id="centerIcao" class="form-control text-uppercase" placeholder="ABCD">
                        </div>
                        <div class="form-group">
                            <label>Przypisana Służba</label>
                            <select id="centerAirService" class="form-control">
                                <option value="0">Medyczna (LPR / HEMS)</option>
                                <option value="1">Policja</option>
                                <option value="2">Straż Pożarna</option>
                            </select>
                        </div>
                    </div>
                    <div class="card-footer text-right">
                        <button type="button" onclick="window.registerNewCenter()" class="btn btn-warning text-bold">Dodaj Placówkę</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card card-dark shadow">
                <div class="card-header"><h3 class="card-title m-0">Lista Placówek w Systemie</h3></div>
                <div class="card-body p-0">
                    <table class="table table-striped table-valign-middle m-0">
                        <thead>
                            <tr>
                                <th>Nazwa</th>
                                <th>Region</th>
                                <th>ID (GUID)</th>
                                <th class="text-right">Zarządzanie</th>
                            </tr>
                        </thead>
                        <tbody id="centers-table-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="universalDispatchModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow-lg">
            <div class="modal-header text-white" id="dispatch-modal-header">
                <h5 class="modal-title font-weight-bold" id="dispatch-modal-title"><i class="fas fa-truck mr-2"></i> Dysponowanie Jednostki</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-0">
                <input type="hidden" id="dispatchTargetIncidentId">
                <div id="weather-widget-container" class="alert alert-dark p-2 m-3 d-none shadow-sm border-secondary">
                    <div class="row align-items-center">
                        <div class="col-md-6 border-right border-secondary">
                            <h6 class="mb-1 text-light"><i class="fas fa-road text-info"></i> Warunki drogowe z OWM</h6>
                            <div class="d-flex align-items-center">
                                <img id="w-icon" src="" alt="Pogoda" width="50" height="50">
                                <div class="ml-2 text-white">
                                    <span id="w-temp" class="font-weight-bold" style="font-size: 1.2rem;"></span>°C - <span id="w-desc" class="text-capitalize"></span><br>
                                    <span id="w-ground-alerts"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="mb-1 text-light"><i class="fas fa-helicopter text-warning"></i> Lotnictwo AVWX</h6>
                            <div class="text-white">
                                Reguły: <span id="w-flight-rules" class="badge" style="font-size: 1rem;"></span>
                                <small class="text-muted ml-1" id="w-station"></small><br>
                                <span id="w-flight-alerts" class="mt-1 d-inline-block"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <table class="table table-hover m-0">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th>Tablice / Nr</th>
                            <th id="dispatch-col-type">Typ/Model</th>
                            <th>Baza / Szpital</th>
                            <th class="text-right">Akcja</th>
                        </tr>
                    </thead>
                    <tbody id="available-units-list">
                        <tr><td colspan="4" class="text-center p-4">Wybierz jednostkę do zadysponowania...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Anuluj</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="statusModal" tabindex="-1" role="dialog">
    <div class="modal-dialog shadow-lg">
        <div class="modal-content border-info">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title font-weight-bold">Aktualizacja Parametrów Zdarzenia</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form id="changeStatusForm">
                <div class="modal-body">
                    <input type="hidden" id="editIncidentId">
                    <div class="form-group">
                        <label>Status operacyjny</label>
                        <select id="editIncidentStatus" class="form-control">
                            <option value="Nowe">Nowe</option>
                            <option value="W toku">W toku</option>
                            <option value="Zakończone">Zakończone</option>
                            <option value="Fałszywy alarm">Fałszywy alarm</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Poziom Zagrożenia (Severity)</label>
                        <select id="editIncidentPriority" class="form-control">
                            <option value="4">Krytyczny</option>
                            <option value="3">Wysoki</option>
                            <option value="2">Średni</option>
                            <option value="1">Niski</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-sync"></i> Zmień/Dodaj zdjęcie</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="editIncPhoto" accept="image/*">
                            <label class="custom-file-label" for="editIncPhoto" id="editIncPhotoLabel">Wybierz nowe zdjęcie...</label>
                        </div>
                    </div>
                    <p id="edit-error" class="text-danger d-none font-weight-bold"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link text-muted" data-dismiss="modal">Zamknij</button>
                    <button type="submit" class="btn btn-info font-weight-bold shadow-sm" id="btn-save-status">Zaktualizuj bazę</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="rankModal" tabindex="-1" role="dialog">
    <div class="modal-dialog shadow-lg">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-bold"><i class="fas fa-user-shield"></i> Modyfikacja Uprawnień</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form id="changeRankForm">
                <div class="modal-body">
                    <input type="hidden" id="editOperatorId">
                    <div class="form-group">
                        <label>Nowa ranga w strukturze CPR</label>
                        <select id="editOperatorRank" class="form-control" required>
                            <option value="Dyspozytor112">Dyspozytor 112</option>
                            <option value="Admin112">Administrator 112</option>
                        </select>
                    </div>
                    <p id="edit-rank-error" class="text-danger d-none font-weight-bold"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-dismiss="modal">Anuluj</button>
                    <button type="submit" class="btn btn-warning font-weight-bold shadow-sm">Zatwierdź zmianę!</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content border-secondary bg-dark text-white shadow-lg">
            <div class="modal-header border-secondary">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-history text-info mr-2"></i> Oś Czasu Zgłoszenia</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-4" style="max-height: 60vh; overflow-y: auto;">
                <div class="timeline timeline-inverse" id="history-timeline">
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Zamknij</button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

@section Scripts {
    <script src="~/js/auth-handler.js" asp-append-version="true"></script>
    <script src="~/js/dispatch-ui.js" asp-append-version="true"></script>
    <script src="~/js/dispatch-admin.js" asp-append-version="true"></script>
    <script>
        let map;
        let markersLayer;
        let routeLayer;
        let tempMarker = null;

        document.addEventListener("DOMContentLoaded", async function () {
                const token = await window.ensureValidToken();
                    if (!token) {
                        window.location.href = "/AuthView/Login";
                        return;
                    }

            map = L.map('map').setView([52.2297, 21.0122], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            markersLayer = L.featureGroup().addTo(map);
            routeLayer = L.featureGroup().addTo(map);

            map.on('click', function(e) {
                const lat = e.latlng.lat.toFixed(5);
                const lng = e.latlng.lng.toFixed(5);

                const incLatInput = document.getElementById('incLat');
                const incLngInput = document.getElementById('incLng');
                if(incLatInput && incLngInput) { incLatInput.value = lat; incLngInput.value = lng; }

                const centerLatInput = document.getElementById('centerLat');
                const centerLngInput = document.getElementById('centerLng');
                if(centerLatInput && centerLngInput) { centerLatInput.value = lat; centerLngInput.value = lng; }

                if (tempMarker) { tempMarker.setLatLng(e.latlng); }
                else { tempMarker = L.marker(e.latlng).addTo(map).bindPopup("Wybrany punkt docelowy").openPopup(); }
            });

            try {
                if(typeof window.loadIncidentTypes === 'function') await window.loadIncidentTypes();
                if(typeof window.loadCentersToSelect === 'function') await window.loadCentersToSelect();
                if(typeof window.checkAdminVisibility === 'function') window.checkAdminVisibility();
                if(typeof window.refreshAll === 'function') await window.refreshAll();

                window.addEventListener('hashchange', window.togglePanels);
                if(typeof window.togglePanels === 'function') window.togglePanels();
            } catch (err) {
                console.error("Błąd podczas ładowania strony:", err);
            }
        });

        window.refreshMapData = async function() {
            if (!map || !markersLayer) return;
            markersLayer.clearLayers();
            routeLayer.clearLayers();

            const headers = { 'Authorization': 'Bearer ' + window.jwtToken };

            const redIcon = new L.Icon({ iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png', shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png', iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34] });
            const blueIcon = new L.Icon({ iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png', shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png', iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34] });
            const greenIcon = new L.Icon({ iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png', shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png', iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34] });
            const orangeIcon = new L.Icon({ iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-orange.png', shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png', iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34] });

            try {
                const [incRes, hospRes, polRes, fireRes] = await Promise.all([
                    fetch('/api/CPR112/Incidents', { headers }),
                    fetch('/api/Medical/hospitals', { headers }),
                    fetch('/api/Police/departments', { headers }),
                    fetch('/api/Fire/departments', { headers })
                ]);

                if (incRes.ok) {
                    const incidents = await incRes.json();
                    incidents.forEach(inc => {
                        if (inc.latitude && inc.longitude && inc.status !== "Zakończone") {
                            L.marker([inc.latitude, inc.longitude], {icon: redIcon})
                             .bindPopup(`<b><i class="fas fa-exclamation-triangle text-danger"></i> ${inc.incidentNumber || 'Zgłoszenie'}</b><br>${inc.description}<br>Status: <b>${inc.status}</b>`)
                             .addTo(markersLayer);
                        }
                    });
                }

                if (hospRes.ok) {
                    const hospitals = await hospRes.json();
                    hospitals.forEach(h => {
                        if (h.latitude && h.longitude) {
                            L.marker([h.latitude, h.longitude], {icon: greenIcon})
                             .bindPopup(`<b><i class="fas fa-hospital text-success"></i> ${h.name}</b><br>SOR: ${h.hasSOR ? 'Tak' : 'Nie'}<br>Zasięg: ${h.operatingRadiusKm || 15} km`)
                             .addTo(markersLayer);
                        }
                    });
                }

                if (polRes.ok) {
                    const polDepts = await polRes.json();
                    polDepts.forEach(p => {
                        if (p.latitude && p.longitude) {
                            L.marker([p.latitude, p.longitude], {icon: blueIcon})
                             .bindPopup(`<b><i class="fas fa-shield-alt text-primary"></i> ${p.name}</b><br>Zasięg: ${p.operatingRadiusKm || 15} km`)
                             .addTo(markersLayer);
                        }
                    });
                }

                if (fireRes.ok) {
                    const fireDepts = await fireRes.json();
                    fireDepts.forEach(f => {
                        if (f.latitude && f.longitude) {
                            L.marker([f.latitude, f.longitude], {icon: orangeIcon})
                             .bindPopup(`<b><i class="fas fa-fire-extinguisher text-danger"></i> ${f.name}</b><br>Zasięg: ${f.operatingRadiusKm || 15} km`)
                             .addTo(markersLayer);
                        }
                    });
                }
            } catch(e) {
                console.error("Błąd mapy operacyjnej:", e);
            }
        };

        window.flyToMap = function(lat, lng) {
            if(map) {
                map.flyTo([lat, lng], 16, { animate: true, duration: 1.5 });
            }
        };
    </script>
}