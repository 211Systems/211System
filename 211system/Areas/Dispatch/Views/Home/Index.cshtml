@{
    ViewData["Title"] = "Centrum Powiadamiania Ratunkowego 112";
}

<style>
    .user-avatar-container {
        position: relative;
        cursor: pointer;
        display: inline-block;
        vertical-align: middle;
    }

    .user-avatar {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #fff;
        transition: transform 0.2s;
        background-color: #ccc;
    }

        .user-avatar:hover {
            transform: scale(1.1);
        }

    #avatarInput {
        display: none;
    }

    .fade-panel {
        animation: fadeIn 0.4s;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .amb-row {
        transition: background 0.2s;
    }

        .amb-row:hover {
            background-color: #f8f9fa !important;
            cursor: pointer;
        }

    .incident-photo-link {
        color: #ffc107;
        cursor: pointer;
        transition: transform 0.2s;
        display: inline-block;
    }

        .incident-photo-link:hover {
            transform: scale(1.2);
            color: #e0a800;
        }

    .table-valign-middle td {
        vertical-align: middle !important;
    }

    .card-title {
        font-weight: 600;
    }

    .btn-group .btn {
        margin-left: 2px;
    }

    .custom-file-label::after {
        content: "Szukaj";
    }

    .status-tile {
        cursor: pointer;
        transition: transform 0.2s;
    }

        .status-tile:hover {
            transform: scale(1.02);
        }
</style>

<div id="incidents-panel" class="fade-panel">
    <div class="row mb-3" id="status-board">
        <div class="col-md-4 col-12">
            <div class="info-box bg-primary shadow status-tile" onclick="openDispatchModal('police')">
                <span class="info-box-icon"><i class="fas fa-car-side"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Dysponuj Radiowóz</span>
                    <span class="info-box-number" id="status-police">0 / 0</span>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="info-box bg-success shadow status-tile" onclick="openDispatchModal('medic')">
                <span class="info-box-icon"><i class="fas fa-ambulance"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Dysponuj Karetkę</span>
                    <span class="info-box-number" id="status-medic">Ładowanie...</span>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="info-box bg-danger shadow status-tile" onclick="openDispatchModal('fire')">
                <span class="info-box-icon"><i class="fas fa-fire-extinguisher"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Dysponuj Wóz PSP</span>
                    <span class="info-box-number" id="status-fire">0 / 0</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card card-danger shadow">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-phone-slash"></i> Nowe Zgłoszenie 112</h3>
                </div>
                <form id="createIncidentForm">
                    <div class="card-body">
                        <div class="form-group">
                            <label>Opis Zdarzenia</label>
                            <textarea id="incDescription" class="form-control" rows="3" placeholder="Co się dzieje?..." required></textarea>
                        </div>
                        <div class="form-group">
                            <label>Priorytet</label>
                            <select id="incSeverity" class="form-control" required>
                                <option value="Wysoki">Wysoki</option>
                                <option value="Średni">Średni</option>
                                <option value="Niski">Niski</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-camera"></i> Zdjęcie (opcjonalnie)</label>
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="incPhoto" accept="image/*">
                                    <label class="custom-file-label" for="incPhoto" id="incPhotoLabel">Wybierz plik...</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Lokalizacja (Placówka)</label>
                            <select id="incLocationId" class="form-control" required>
                                <option value="">Ładowanie placówek...</option>
                            </select>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-danger btn-block font-weight-bold" id="btn-submit-incident">
                            <i class="fas fa-plus"></i> Rejestruj Incydent
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card card-dark shadow">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title m-0"><i class="fas fa-list-ul"></i> Aktywne Interwencje</h3>
                    <div>
                        <button class="btn btn-sm btn-warning text-dark mr-2" onclick="alert('Tu będzie AI!')"><i class="fas fa-magic"></i> Auto-Dyspozycja AI</button>
                        <button class="btn btn-sm btn-outline-light" onclick="refreshAll()"><i class="fas fa-sync-alt"></i> Odśwież</button>
                    </div>
                </div>
                <div class="card-body p-0 table-responsive" style="max-height: 600px; overflow-y: auto;">
                    <table class="table table-striped table-hover m-0 table-valign-middle">
                        <thead class="bg-secondary">
                            <tr>
                                <th style="width: 15%">Numer</th>
                                <th style="width: 35%">Opis</th>
                                <th style="width: 15%">Priorytet</th>
                                <th style="width: 10%">Status</th>
                                <th style="width: 25%" class="text-right">Akcje</th>
                            </tr>
                        </thead>
                        <tbody id="incidents-table-body">
                            <tr><td colspan="5" class="text-center p-4">Inicjalizacja systemu...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="operators-panel" class="d-none fade-panel">
</div>
<div id="centers-panel" class="d-none fade-panel">
</div>

<div class="modal fade" id="universalDispatchModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow-lg">
            <div class="modal-header text-white" id="dispatch-modal-header">
                <h5 class="modal-title font-weight-bold" id="dispatch-modal-title"><i class="fas fa-truck mr-2"></i> Dysponowanie Jednostki</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-0">
                <table class="table table-hover m-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Tablice / Nr</th>
                            <th id="dispatch-col-type">Typ/Model</th>
                            <th>Baza / Szpital</th>
                            <th class="text-right">Akcja</th>
                        </tr>
                    </thead>
                    <tbody id="available-units-list">
                        <tr><td colspan="4" class="text-center p-4">Wybierz jednostkę do zadysponowania...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Anuluj</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="statusModal" tabindex="-1" role="dialog">
</div>
<div class="modal fade" id="rankModal" tabindex="-1" role="dialog">
</div>

@section Scripts {
    <script>
        window.jwtToken = localStorage.getItem('jwt');

        document.addEventListener("DOMContentLoaded", async function () {
            if (!window.jwtToken) {
                window.location.href = "/AuthView/Login";
                return;
            }
            try {
                if(typeof window.loadCentersToSelect === 'function') await window.loadCentersToSelect();
                if(typeof window.checkAdminVisibility === 'function') window.checkAdminVisibility();
                if(typeof window.refreshAll === 'function') await window.refreshAll();

                window.addEventListener('hashchange', window.togglePanels);
                if(typeof window.togglePanels === 'function') window.togglePanels();
            } catch (err) {
                console.error("Błąd podczas ładowania strony:", err);
            }
        });
    </script>

    <script src="~/js/dispatch-ui.js"></script>
    <script src="~/js/dispatch-admin.js"></script>
    <script src="~/js/dispatch-incidents.js"></script>
}