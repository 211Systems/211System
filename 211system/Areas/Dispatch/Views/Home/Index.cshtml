@section Scripts {
    <script src="~/js/incident-attachments.js" asp-append-version="true"></script>
    <script src="~/js/incident-detail-map.js" asp-append-version="true"></script>
    <script src="~/js/dispatch-ui.js" asp-append-version="true"></script>
    <script src="~/js/dispatch-admin.js" asp-append-version="true"></script>

    <script>
        window.openEditRankModal = function(id, currentRank) {
            document.getElementById('editOperatorId').value = id;
            document.getElementById('editOperatorRank').value = currentRank;
            $('#rankModal').modal('show');
        };

        window.submitRankChange = async function() {
            const id = document.getElementById('editOperatorId').value;
            const newRank = document.getElementById('editOperatorRank').value;

            try {
                const response = await fetch(`/api/Operators/${id}/rank`, {
                    method: 'PUT',
                    headers: {
                        'Authorization': 'Bearer ' + window.jwtToken,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ newRank: newRank })
                });

                if (response.ok) {
                    alert("Ranga została zmieniona pomyślnie.");
                    $('#rankModal').modal('hide');
                    if (typeof window.loadOperators === 'function') {
                        window.loadOperators();
                    }
                } else {
                    alert("Błąd podczas zmiany rangi.");
                }
            } catch (e) {
                console.error(e);
                alert("Błąd połączenia z serwerem.");
            }
        };

        let map;
        let pickerMap;
        let markersLayer;
        let routeLayer;
        let tempMarker = null;
        let pickerMarker = null;

        window.loadEncFacilities = async function loadEncFacilities() {
            try {
                const response = await fetch('/api/Enc', {
                    headers: { 'Authorization': 'Bearer ' + window.jwtToken }
                });

                if (response.ok) {
                    const facilities = await response.json();
                    const select = document.getElementById('regEncId');
                    if (!select) return;
                    select.innerHTML = '<option value="">-- Wybierz placówkę --</option>';

                    facilities.forEach(f => {
                        const opt = document.createElement('option');
                        opt.value = f.id;
                        opt.textContent = f.name;
                        select.appendChild(opt);
                    });
                } else {
                    console.error("Nie udało się pobrać placówek");
                }
            } catch (err) {
                console.error("Błąd sieci przy pobieraniu placówek:", err);
            }
        }

        document.addEventListener("DOMContentLoaded", async function () {
            await loadEncFacilities();
            window.togglePanels();

            if (!window.jwtToken) {
                window.jwtToken = localStorage.getItem('jwt');
                if(!window.jwtToken) {
                    window.location.href = "/AuthView/Login";
                    return;
                }
            }

            window.currentOperatorId = null;

            map = L.map('map').setView([52.2297, 21.0122], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap contributors' }).addTo(map);
            markersLayer = L.featureGroup().addTo(map);
            routeLayer = L.featureGroup().addTo(map);

            map.on('click', function(e) {
                const lat = e.latlng.lat.toFixed(5);
                const lng = e.latlng.lng.toFixed(5);
                document.getElementById('incLat').value = lat;
                document.getElementById('incLng').value = lng;
                if (tempMarker) tempMarker.setLatLng(e.latlng);
                else tempMarker = L.marker(e.latlng).addTo(map).bindPopup("Wybrany punkt docelowy (Incydent)").openPopup();
            });

            pickerMap = L.map('picker-map').setView([52.2297, 21.0122], 11);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OSM' }).addTo(pickerMap);
            let pickerCircle = null;

            pickerMap.on('click', function (e) {
                const lat = e.latlng.lat.toFixed(5);
                const lng = e.latlng.lng.toFixed(5);
                document.getElementById('centerLat').value = lat;
                document.getElementById('centerLng').value = lng;

                if (pickerMarker) pickerMarker.setLatLng(e.latlng);
                else pickerMarker = L.marker(e.latlng).addTo(pickerMap);

                const radiusKm = document.getElementById('centerRadius').value || 15;
                if (pickerCircle) pickerMap.removeLayer(pickerCircle);
                pickerCircle = L.circle(e.latlng, { color: '#007bff', fillColor: '#007bff', fillOpacity: 0.2, radius: radiusKm * 1000 }).addTo(pickerMap);
            });

            document.getElementById('centerRadius').addEventListener('change', function() {
                if (pickerMarker) {
                    if (pickerCircle) pickerMap.removeLayer(pickerCircle);
                    pickerCircle = L.circle(pickerMarker.getLatLng(), { color: '#007bff', fillColor: '#007bff', fillOpacity: 0.2, radius: this.value * 1000 }).addTo(pickerMap);
                }
            });

            try {
                if(typeof window.loadIncidentTypes === 'function') await window.loadIncidentTypes();
                if(typeof window.loadCentersToSelect === 'function') await window.loadCentersToSelect();
                if(typeof window.checkAdminVisibility === 'function') window.checkAdminVisibility();
                if(typeof window.refreshAll === 'function') await window.refreshAll();
            } catch (err) {}

            window.addEventListener('hashchange', window.togglePanels);
        });

        window.refreshMapData = async function() {
            if (!map || !markersLayer) return;
            markersLayer.clearLayers();
            routeLayer.clearLayers();

            const headers = { 'Authorization': 'Bearer ' + window.jwtToken };

            const createMarkerIcon = (iconClass, bgColor, isBuilding = false, hasHelipad = false) => {
                const borderRadius = isBuilding ? '8px' : '50%';
                const helipadBadge = hasHelipad ? `<div style="position: absolute; bottom: -6px; right: -6px; background-color: #ffc107; color: #000; font-size: 10px; font-weight: bold; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 1px solid #343a40;" title="Posiada Lądowisko">H</div>` : '';

                const htmlContent = `
                    <div style="background-color: ${bgColor}; color: white; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; border-radius: ${borderRadius}; border: 2px solid white; box-shadow: 0 3px 6px rgba(0,0,0,0.5); position: relative;">
                        <i class="fas ${iconClass}"></i>
                        ${helipadBadge}
                    </div>`;

                return L.divIcon({
                    html: htmlContent,
                    className: 'custom-building-marker',
                    iconSize: [34, 34],
                    iconAnchor: [17, 17],
                    popupAnchor: [0, -17]
                });
            };

            const iconIncident = createMarkerIcon('fa-exclamation-triangle', '#dc3545', false);
            const iconHospital = (hasHeli) => createMarkerIcon('fa-hospital', '#28a745', true, hasHeli);
            const iconPolice = (hasHeli) => createMarkerIcon('fa-shield-alt', '#007bff', true, hasHeli);
            const iconFire = (hasHeli) => createMarkerIcon('fa-fire-extinguisher', '#fd7e14', true, hasHeli);
            const iconAirbase = createMarkerIcon('fa-plane-departure', '#343a40', true, true);

            try {
                const [incRes, hospRes, polRes, fireRes, airRes] = await Promise.all([
                    fetch('/api/CPR112/Incidents', { headers }),
                    fetch('/api/Medical/hospitals', { headers }),
                    fetch('/api/Police/departments', { headers }),
                    fetch('/api/Fire/departments', { headers }),
                    fetch('/api/Aviation/airbases', { headers })
                ]);

                if (incRes.ok) {
                    const incidents = await incRes.json();
                    incidents.forEach(inc => {
                        if (inc.latitude && inc.longitude && inc.status !== "Zakończone") {
                            L.marker([inc.latitude, inc.longitude], { icon: iconIncident })
                             .bindPopup(`<b><i class="fas fa-exclamation-triangle text-danger"></i> ${inc.incidentNumber || 'Zgłoszenie'}</b><br>${inc.description}<br>Status: <b>${inc.status}</b>`)
                             .addTo(markersLayer);
                        }
                    });
                }

                if (hospRes.ok) {
                    const hospitals = await hospRes.json();
                    hospitals.forEach(h => {
                        if (h.latitude && h.longitude) {
                            const hasHeli = h.hasHelipad || h.HasHelipad || false;
                            L.marker([h.latitude, h.longitude], { icon: iconHospital(hasHeli) })
                             .bindPopup(`<b><i class="fas fa-hospital text-success"></i> ${h.name}</b><br>SOR: ${h.hasSOR ? 'Tak' : 'Nie'}<br>Zasięg: ${h.operatingRadiusKm || 15} km`)
                             .addTo(markersLayer);
                        }
                    });
                }

                if (polRes.ok) {
                    const polDepts = await polRes.json();
                    polDepts.forEach(p => {
                        if (p.latitude && p.longitude) {
                            const hasHeli = p.hasHelipad || p.HasHelipad || false;
                            L.marker([p.latitude, p.longitude], { icon: iconPolice(hasHeli) })
                             .bindPopup(`<b><i class="fas fa-shield-alt text-primary"></i> ${p.name}</b><br>Zasięg: ${p.operatingRadiusKm || 15} km`)
                             .addTo(markersLayer);
                        }
                    });
                }

                if (fireRes.ok) {
                    const fireDepts = await fireRes.json();
                    fireDepts.forEach(f => {
                        if (f.latitude && f.longitude) {
                            const hasHeli = f.hasHelipad || f.HasHelipad || false;
                            L.marker([f.latitude, f.longitude], { icon: iconFire(hasHeli) })
                             .bindPopup(`<b><i class="fas fa-fire-extinguisher text-danger"></i> ${f.name}</b><br>Zasięg: ${f.operatingRadiusKm || 15} km`)
                             .addTo(markersLayer);
                        }
                    });
                }

                if (airRes.ok) {
                    const airbases = await airRes.json();
                    airbases.forEach(a => {
                        if (a.latitude && a.longitude) {
                            L.marker([a.latitude, a.longitude], { icon: iconAirbase })
                             .bindPopup(`<b><i class="fas fa-helicopter text-dark"></i> ${a.name}</b><br>Kod: ${a.icaoCode || 'Brak'}`)
                             .addTo(markersLayer);
                        }
                    });
                }
            } catch(e) {
                console.error("Błąd mapy operacyjnej:", e);
            }
        };

        window.togglePanels = function () {
            const h = window.location.hash;
            document.querySelectorAll('.fade-panel').forEach(el => {
                el.classList.remove('active');
            });

            if (h === '#admin-operator-section') {
                document.getElementById('operators-panel').classList.add('active');
                if (typeof window.loadOperators === 'function') window.loadOperators();
                if (typeof window.loadEncFacilities === 'function') window.loadEncFacilities();
                if (typeof window.loadCentersToSelect === 'function') window.loadCentersToSelect();
            } else if (h === '#admin-centers-section') {
                document.getElementById('centers-panel').classList.add('active');
                if (typeof window.loadCenters === 'function') window.loadCenters();
                setTimeout(() => { pickerMap.invalidateSize(); }, 300);
            } else {
                document.getElementById('incidents-panel').classList.add('active');
                setTimeout(() => { map.invalidateSize(); }, 300);
            }
        };

        window.registerNewOperator = async function () {
            const dto = {
                firstName: document.getElementById('regFirstName').value,
                lastName: document.getElementById('regLastName').value,
                stationNumber: document.getElementById('regStation').value,
                encId: document.getElementById('regEncId').value,
                email: document.getElementById('regEmail').value,
                rank: document.getElementById('regRank').value
            };

            if (!dto.email || !dto.lastName || !dto.encId) {
                alert("Uzupełnij wszystkie dane operatora (w tym wybór placówki)!"); return;
            }

            try {
                const response = await fetch('/api/Operators', { method: 'POST', headers: { 'Authorization': 'Bearer ' + window.jwtToken, 'Content-Type': 'application/json' }, body: JSON.stringify(dto) });
                if (response.ok) {
                    const result = await response.json();
                    document.getElementById('new-password-display').innerText = result.temporaryPassword || result.operatorDetails?.temporaryPassword || '—';
                    $('#unlockedAccountModal').modal('show');
                    document.getElementById('registerOperatorForm').reset();
                    if (typeof window.loadOperators === 'function') window.loadOperators();
                    if (typeof window.loadEncFacilities === 'function') await window.loadEncFacilities();
                } else {
                    const err = await response.json();
                    alert("Błąd: " + (err.message || "Nie udało się zarejestrować operatora."));
                }
            } catch (e) { alert("Błąd krytyczny połączenia z serwerem."); }
        };

        window.registerNewCenter = async function () {
            const nameVal = document.getElementById('centerName').value;
            const latVal = document.getElementById('centerLat').value;
            const lngVal = document.getElementById('centerLng').value;
            const radiusVal = document.getElementById('centerRadius').value;
            const type = document.getElementById('centerType').value;

            if (!nameVal || !latVal || !lngVal) { alert("Wypełnij nazwę i wskaż lokalizację na mapie!"); return; }

            let url = ''; let dto = {};
            const hasHelipad = document.getElementById('hasHelipad').checked;

            if (type === 'Airbase') {
                url = '/api/Aviation/airbases';
                dto = { name: nameVal, icaoCode: document.getElementById('centerIcao').value || "Brak", serviceType: parseInt(document.getElementById('centerAirService').value), latitude: parseFloat(latVal), longitude: parseFloat(lngVal) };
            } else {
                const regionVal = document.getElementById('centerRegion').value || "Brak Danych";
                dto = { name: nameVal, region: regionVal, address: regionVal, district: regionVal, latitude: parseFloat(latVal), longitude: parseFloat(lngVal), operatingRadiusKm: parseFloat(radiusVal), hasHelipad: hasHelipad };
                if (type === 'Hospital') url = '/api/Medical/hospitals';
                else if (type === 'Police') url = '/api/Police/departments';
                else if (type === 'Fire') url = '/api/Fire/departments';
                else url = '/api/Enc';
            }

            try {
                const response = await fetch(url, { method: 'POST', headers: { 'Authorization': 'Bearer ' + window.jwtToken, 'Content-Type': 'application/json' }, body: JSON.stringify(dto) });
                if (response.ok) {
                    alert("Placówka dodana do systemu.");
                    document.getElementById('createCenterForm').reset();
                    if (typeof window.loadCenters === 'function') await window.loadCenters();
                    if (typeof window.loadCentersToSelect === 'function') await window.loadCentersToSelect();
                    if (typeof window.loadEncFacilities === 'function') await window.loadEncFacilities();
                } else { alert(`Błąd serwera. Sprawdź konsole.`); }
            } catch (e) { alert("Błąd krytyczny komunikacji z serwerem."); }
        };

        window.autoDispatchAI = async function() {
            const btn = document.querySelector('button[onclick="window.autoDispatchAI()"]');
            if (!btn) {
                alert("Nie znaleziono przycisku Auto-Dyspozycja AI na stronie.");
                return;
            }
            const originalContent = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> AI Analizuje...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/Ai/auto-dispatch', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + window.jwtToken }
                });

                if (response.status === 503 || response.status === 429) {
                    let payload = null;
                    try { payload = await response.json(); } catch (_) { }
                    const msg = (payload && payload.message)
                        ? payload.message
                        : "Model AI Gemini jest aktualnie przeciążony. Spróbuj ponownie za chwilę.";
                    console.warn("AI tymczasowo niedostępne:", payload || response.status);
                    alert(msg + "\n\nMożesz w międzyczasie ręcznie wysłać jednostki przyciskami w panelach służb.");
                    return;
                }

                if (response.ok) {
                    window.aiSuggestionsData = await response.json();

                    if (window.aiSuggestionsData.length === 0) {
                        alert("Brak nowych incydentów lub brak wolnych jednostek.");
                        return;
                    }

                    const tbody = document.getElementById('ai-suggestions-body');
                    if (!tbody) {
                        alert("Brak modala AI na stronie (element #ai-suggestions-body). Dodaj aiDispatchModal do Index.cshtml.");
                        return;
                    }
                    tbody.innerHTML = '';

                    window.aiSuggestionsData.forEach(sug => {
                        let badge = 'badge-secondary';
                        if (sug.unitType === 'Medical') badge = 'badge-success';
                        else if (sug.unitType === 'Police') badge = 'badge-primary';
                        else if (sug.unitType === 'Fire') badge = 'badge-danger';

                        tbody.insertAdjacentHTML('beforeend', `
                            <tr>
                                <td><small class="text-muted">${sug.incidentId}</small></td>
                                <td><span class="badge ${badge} p-2">${sug.unitType}</span></td>
                                <td class="font-weight-bold text-warning">${sug.unitId}</td>
                                <td><small>${sug.reasoning}</small></td>
                            </tr>
                        `);
                    });

                    console.log("Dane od AI:", window.aiSuggestionsData);
                    $('#aiDispatchModal').appendTo('body').modal('show');
                } else {
                    let payload = null;
                    try { payload = await response.json(); } catch (_) { }
                    const detail = (payload && (payload.message || payload.title))
                        || `HTTP ${response.status}`;
                    console.error("Błąd analizy AI:", payload || response.status);
                    alert("Błąd podczas analizy AI:\n" + detail);
                }
            } catch (e) {
                console.error(e);
                alert("Błąd podczas Auto-Dyspozycji AI: " + (e && e.message ? e.message : "nieznany"));
            } finally {
                btn.innerHTML = originalContent;
                btn.disabled = false;
            }
        };

        window.confirmAiDispatch = async function() {
            if (!confirm("Potwierdzasz zadysponowanie tych jednostek?")) return;
            try {
                const response = await fetch('/api/Ai/confirm-dispatch', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + window.jwtToken,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(window.aiSuggestionsData)
                });

                let payload = null;
                try { payload = await response.json(); } catch (_) { }

                if (response.ok) {
                    $('#aiDispatchModal').modal('hide');

                    const assignedCount = payload && payload.assigned ? payload.assigned.length : 0;
                    const skippedCount = payload && payload.skipped ? payload.skipped.length : 0;

                    let msg = `Sukces! Zadysponowano ${assignedCount} jednostek.`;
                    if (skippedCount > 0) {
                        msg += `\n\nPominięto ${skippedCount} propozycji:`;
                        payload.skipped.forEach(s => {
                            msg += `\n• ${s.unitType || '?'} (${s.unitId || '?'}) - ${s.reason || 'brak powodu'}`;
                        });
                    }
                    alert(msg);

                    window.refreshMapData();
                    window.refreshAll();
                } else {
                    let detail = `HTTP ${response.status}`;

                    if (payload) {
                        if (payload.message) {
                            detail = payload.message;
                        } else if (payload.title) {
                            detail = payload.title;
                            if (payload.errors && typeof payload.errors === 'object') {
                                const errs = Object.entries(payload.errors)
                                    .map(([k, v]) => `${k}: ${Array.isArray(v) ? v.join('; ') : v}`)
                                    .join('\n');
                                if (errs) detail += `\n${errs}`;
                            }
                        } else {
                            detail = JSON.stringify(payload);
                        }

                        if (payload.skipped && payload.skipped.length > 0) {
                            detail += "\n\nPominięte propozycje:";
                            payload.skipped.forEach(s => {
                                detail += `\n• ${s.unitType || '?'} (${s.unitId || '?'}) - ${s.reason || 'brak powodu'}`;
                            });
                        }
                    }

                    console.error("Błąd zapisu dyspozycji:", payload || response.status);
                    alert("Błąd podczas zapisu dyspozycji do bazy.\n\n" + detail);
                }
            } catch (e) {
                console.error("Błąd sieci confirmAiDispatch:", e);
                alert("Błąd sieci: " + (e && e.message ? e.message : "nieznany"));
            }
        };
    </script>
}