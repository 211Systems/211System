    .dispatch-actions .btn-dispatch-units:hover { background: #3d4349; border-color: #343a40; color: #fff; }
    .dispatch-actions .btn-dispatch-history { background: #6c757d; border-color: #5c636a; color: #fff; }
    .dispatch-actions .btn-dispatch-history:hover { background: #5c636a; border-color: #565e64; color: #fff; }
    .dispatch-actions .btn-dispatch-edit { color: #ffc107; border-color: #ffc107; }
    .dispatch-actions .btn-dispatch-edit:hover { background: #ffc107; color: #212529; }
