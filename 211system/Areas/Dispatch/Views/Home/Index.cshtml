@{
    ViewData["Title"] = "Centrum Powiadamiania Ratunkowego 112";
}

<style>
    .fade-panel {
        display: none;
    }

        .fade-panel.active {
            display: block;
            animation: fadeIn 0.5s;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>

<div id="incidents-panel" class="fade-panel active">
    <div class="card card-dark shadow mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title m-0"><i class="fas fa-map-marked-alt"></i> Mapa Operacyjna</h3>
            <div>
                <button class="btn btn-sm btn-outline-light" onclick="window.refreshMapData()"><i class="fas fa-sync-alt"></i> Odśwież Mapę</button>
            </div>
        </div>
        <div class="card-body p-0">
            <div id="map" style="height: 450px; width: 100%; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;"></div>
        </div>
    </div>

    <div class="row mb-3" id="status-board">
        <div class="col-md-3 col-6 mb-2">
            <div class="info-box bg-primary shadow status-tile" onclick="window.openDispatchModal('police')">
                <span class="info-box-icon"><i class="fas fa-car-side"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Policja</span>
                    <span class="info-box-number" id="status-police">Ładowanie...</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-2">
            <div class="info-box bg-success shadow status-tile" onclick="window.openDispatchModal('medic')">
                <span class="info-box-icon"><i class="fas fa-ambulance"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Karetki</span>
                    <span class="info-box-number" id="status-medic">Ładowanie...</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-2">
            <div class="info-box bg-danger shadow status-tile" onclick="window.openDispatchModal('fire')">
                <span class="info-box-icon"><i class="fas fa-fire-extinguisher"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Straż PSP</span>
                    <span class="info-box-number" id="status-fire">Ładowanie...</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-2">
            <div class="info-box bg-dark shadow status-tile border border-secondary" onclick="window.openDispatchModal('aviation')">
                <span class="info-box-icon"><i class="fas fa-helicopter text-white"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text text-white">Lotnictwo</span>
                    <span class="info-box-number text-white" id="status-aviation">Ładowanie...</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card card-danger shadow">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-phone-slash"></i> Nowe Zgłoszenie 112</h3>
                </div>
                <form id="createIncidentForm">
                    <div class="card-body">
                        <div class="form-group">
                            <label>Opis Zdarzenia</label>
                            <textarea id="incDescription" class="form-control" rows="3" placeholder="Co się dzieje?..." required></textarea>
                        </div>
                        <div class="form-group">
                            <label>Typ Zdarzenia</label>
                            <select id="incType" class="form-control" required>
                                <option value="">Wybierz typ (Ładowanie...)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Priorytet</label>
                            <select id="incSeverity" class="form-control" required>
                                <option value="4">Krytyczny</option>
                                <option value="3">Wysoki</option>
                                <option value="2">Średni</option>
                                <option value="1">Niski</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-paperclip"></i> Załączniki (opcjonalnie, max 10)</label>
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="incPhoto" accept="image/*,.pdf,.docx,.webp" multiple>
                                    <label class="custom-file-label" for="incPhoto" id="incPhotoLabel">Wybierz pliki...</label>
                                </div>
                            </div>
                            <small class="text-muted">JPG, PNG, WEBP, PDF, DOCX — do 5 MB każdy</small>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="row">
                            <div class="col-6">
                                <label><small class="text-muted">Lat (Z mapy)</small></label>
                                <input type="text" id="incLat" class="form-control form-control-sm" readonly placeholder="Kliknij na mapie">
                            </div>
                            <div class="col-6">
                                <label><small class="text-muted">Lng (Z mapy)</small></label>
                                <input type="text" id="incLng" class="form-control form-control-sm" readonly placeholder="Kliknij na mapie">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-danger btn-block font-weight-bold mt-3" id="btn-submit-incident">
                            <i class="fas fa-plus"></i> Rejestruj Incydent
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card card-dark shadow">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title m-0"><i class="fas fa-list-ul"></i> Aktywne Interwencje</h3>
                    <div>
                        <button class="btn btn-sm btn-warning text-dark mr-2" onclick="window.autoDispatchAI()"><i class="fas fa-magic"></i> Auto-Dyspozycja AI</button>
                        <button class="btn btn-sm btn-outline-light" onclick="window.refreshAll()"><i class="fas fa-sync-alt"></i> Odśwież</button>
                    </div>
                </div>
                <div class="bg-dark p-2 border-bottom border-secondary d-flex flex-wrap gap-2 mb-2" id="stats-summary" style="gap: 10px;">
                </div>
                <div class="card-body p-0 table-responsive" style="max-height: 600px; overflow-y: auto;">
                    <table class="table table-striped table-hover m-0 table-valign-middle">
                        <thead class="bg-secondary">
                            <tr>
                                <th style="width: 15%">Numer</th>
                                <th style="width: 25%">Opis</th>
                                <th style="width: 15%">Typ</th>
                                <th style="width: 10%">Priorytet</th>
                                <th style="width: 10%">Status</th>
                                <th style="width: 25%" class="text-right">Akcje</th>
                            </tr>
                        </thead>
                        <tbody id="incidents-table-body">
                            <tr><td colspan="6" class="text-center p-4">Inicjalizacja systemu...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="operators-panel" class="fade-panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning font-weight-bold m-0"><i class="fas fa-users-cog mr-2"></i> Panel Zarządzania Kadrami 112</h2>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="card card-outline card-warning shadow">
                <div class="card-header">
                    <h3 class="card-title text-bold">Rejestracja Operatora</h3>
                </div>
                <form id="registerOperatorForm">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6 form-group"><label>Imię</label><input type="text" id="regFirstName" class="form-control" required></div>
                            <div class="col-6 form-group"><label>Nazwisko</label><input type="text" id="regLastName" class="form-control" required></div>
                        </div>
                        <div class="form-group">
                            <label>Adres E-mail (Login)</label>
                            <input type="email" id="regEmail" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Ranga / Rola</label>
                            <select id="regRank" class="form-control" required>
                                <option value="Dyspozytor112">Dyspozytor 112</option>
                                <option value="Admin112">Administrator 112</option>
                            </select>
                        </div>
                        <div class="row">
                            <div class="col-6 form-group">
                                <label>Numer Stanowiska</label>
                                <input type="text" id="regStation" class="form-control" required>
                            </div>
                            <div class="col-6 form-group">
                                <label>Placówka CPR</label>
                                <select id="regEncId" class="form-control" required><option value="">Wybierz...</option></select>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="button" class="btn btn-warning btn-block text-bold" onclick="window.registerNewOperator()"><i class="fas fa-user-plus"></i> Utwórz konto</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card card-dark shadow">
                <div class="card-header border-0"><h3 class="card-title m-0"><i class="fas fa-id-badge"></i> Aktywny personel CPR</h3></div>
                <div class="card-body p-0">
                    <table class="table table-striped table-valign-middle m-0">
                        <thead>
                            <tr>
                                <th>Operator</th>
                                <th>Ranga</th>
                                <th>Stanowisko</th>
                                <th class="text-right">Akcje</th>
                            </tr>
                        </thead>
                        <tbody id="operators-table-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="centers-panel" class="fade-panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary font-weight-bold m-0"><i class="fas fa-hospital mr-2"></i> Zarządzanie Placówkami CPR</h2>
    </div>
    <div class="row">
        <div class="col-md-5">
            <div class="card card-outline card-primary shadow">
                <div class="card-header"><h3 class="card-title text-bold">Rejestracja nowej Placówki</h3></div>
                <form id="createCenterForm">
                    <div class="card-body">
                        <div class="form-group">
                            <label>Nazwa placówki</label>
                            <input type="text" id="centerName" class="form-control" placeholder="np. CPR Warszawa" required>
                        </div>
                        <div class="form-group">
                            <label>Typ Placówki w systemie</label>
                            <select id="centerType" class="form-control" onchange="window.toggleHelipadOptions()">
                                <option value="Center">Centrum 112 (CPR)</option>
                                <option value="Hospital">Szpital (Medyczna)</option>
                                <option value="Police">Komenda Policji</option>
                                <option value="Fire">Remiza Straży Pożarnej</option>
                                <option value="Airbase">Baza Lotnicza (HEMS)</option>
                            </select>
                        </div>
                        <div class="form-group" id="regionGroup">
                            <label>Region / Lokalizacja / Adres</label>
                            <input type="text" id="centerRegion" class="form-control" placeholder="np. Mazowieckie" required>
                        </div>

                        <div class="form-group mt-3">
                            <label><i class="fas fa-map-marker-alt text-danger"></i> Wybierz lokalizację na mapie</label>
                            <div id="picker-map" style="height: 250px; width: 100%; border-radius: 5px; border: 1px solid #ccc;"></div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-6">
                                <label><small class="text-muted">Latitude</small></label>
                                <input type="text" id="centerLat" class="form-control form-control-sm" readonly required>
                            </div>
                            <div class="col-6">
                                <label><small class="text-muted">Longitude</small></label>
                                <input type="text" id="centerLng" class="form-control form-control-sm" readonly required>
                            </div>
                        </div>

                        <div class="form-group mt-3">
                            <label>Promień operacyjny (Zasięg Działania - KM)</label>
                            <input type="number" id="centerRadius" class="form-control" value="15" min="1" required>
                        </div>

                        <div class="form-group mt-2" id="helipadOptionGroup">
                            <div class="custom-control custom-switch custom-switch-off-danger custom-switch-on-success">
                                <input type="checkbox" class="custom-control-input" id="hasHelipad">
                                <label class="custom-control-label font-weight-bold" for="hasHelipad"><i class="fas fa-h-square text-success"></i> Posiada przyszpitalne Lądowisko</label>
                            </div>
                        </div>

                        <div id="airbaseOptionGroup" class="d-none border p-3 rounded bg-dark mt-2">
                            <h6 class="text-info"><i class="fas fa-plane-departure"></i> Konfiguracja Bazy Lotniczej</h6>
                            <div class="form-group mt-2">
                                <label>Kod lotniska (ICAO - np. EPWA)</label>
                                <input type="text" id="centerIcao" class="form-control text-uppercase" placeholder="ABCD">
                            </div>
                            <div class="form-group">
                                <label>Przypisana Służba</label>
                                <select id="centerAirService" class="form-control">
                                    <option value="0">Medyczna (LPR / HEMS)</option>
                                    <option value="1">Policja</option>
                                    <option value="2">Straż Pożarna</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer text-right">
                        <button type="button" class="btn btn-primary btn-block font-weight-bold shadow-sm" onclick="window.registerNewCenter()">
                            <i class="fas fa-plus"></i> Zarejestruj Strukturę
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card card-dark shadow">
                <div class="card-header border-0"><h3 class="card-title m-0">Placówki i Infrastruktura (Wgląd 112)</h3></div>
                <div class="card-body p-0">
                    <table class="table table-striped table-sm table-valign-middle m-0">
                        <thead>
                            <tr>
                                <th>Nazwa CPR</th>
                                <th>Region</th>
                                <th>ID Systemowe (GUID)</th>
                                <th class="text-right">Akcje</th>
                            </tr>
                        </thead>
                        <tbody id="centers-table-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="unlockedAccountModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content dark-mode border-info">
            <div class="modal-header bg-info">
                <h5 class="modal-title"><i class="fas fa-lock-open"></i> Konto utworzone/odblokowane!</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body text-center">
                <p>Przekaż pracownikowi to nowe, tymczasowe hasło:</p>
                <h2 class="text-warning font-weight-bold my-4" id="new-password-display"></h2>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Zamknij</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="universalDispatchModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow-lg">
            <div class="modal-header text-white" id="dispatch-modal-header">
                <h5 class="modal-title font-weight-bold" id="dispatch-modal-title"><i class="fas fa-truck mr-2"></i> Dysponowanie Jednostki</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-0">
                <input type="hidden" id="dispatchTargetIncidentId">
                <div id="weather-widget-container" class="alert alert-dark p-2 m-3 d-none shadow-sm border-secondary">
                    <div class="row align-items-center">
                        <div class="col-md-6 border-right border-secondary">
                            <h6 class="mb-1 text-light"><i class="fas fa-road text-info"></i> Warunki drogowe z OWM</h6>
                            <div class="d-flex align-items-center">
                                <img id="w-icon" src="" alt="Pogoda" width="50" height="50">
                                <div class="ml-2 text-white">
                                    <span id="w-temp" class="font-weight-bold" style="font-size: 1.2rem;"></span>°C - <span id="w-desc" class="text-capitalize"></span><br>
                                    <span id="w-ground-alerts"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6" id="weather-aviation-panel">
                            <h6 class="mb-1 text-light"><i class="fas fa-helicopter text-warning"></i> Pogoda lotnicza (AVWX / METAR)</h6>
                            <div class="text-white">
                                Reguły: <span id="w-flight-rules" class="badge" style="font-size: 1rem;"></span>
                                <small class="text-muted ml-1" id="w-station"></small><br>
                                <span id="w-flight-alerts" class="mt-1 d-inline-block"></span>
                                <small id="w-metar" class="d-block text-muted mt-1" style="font-size: 0.75rem; word-break: break-word;"></small>
                            </div>
                        </div>
                    </div>
                </div>
                <table class="table table-hover m-0">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th>Tablice / Nr</th>
                            <th id="dispatch-col-type">Typ/Model</th>
                            <th>Baza / Szpital</th>
                            <th class="text-right">Akcja</th>
                        </tr>
                    </thead>
                    <tbody id="available-units-list">
                        <tr><td colspan="4" class="text-center p-4">Wybierz jednostkę do zadysponowania...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Anuluj</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="historyModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-secondary bg-dark text-white shadow-lg">
            <div class="modal-header border-secondary">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-history text-info mr-2"></i> Oś Czasu Zgłoszenia</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-4" style="max-height: 60vh; overflow-y: auto;">
                <div class="timeline timeline-inverse" id="history-timeline">
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Zamknij</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="aiDispatchModal" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content dark-mode border-warning shadow-lg">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-robot"></i> Propozycja Dyspozycji AI (Gemini)</h5>
                <button type="button" class="close text-dark" data-dismiss="modal" aria-label="Zamknij">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <div class="alert alert-dark m-3 border-warning text-warning">
                    <i class="fas fa-info-circle"></i> AI przeanalizowało zdarzenia i dobrało najlepsze wolne jednostki. <strong>Zweryfikuj plan przed wysłaniem!</strong>
                </div>
                <table class="table table-striped table-hover m-0">
                    <thead class="bg-secondary">
                        <tr>
                            <th>Incydent (ID / Opis)</th>
                            <th>Typ Służby</th>
                            <th>Zaproponowana Jednostka</th>
                            <th>Uzasadnienie AI</th>
                        </tr>
                    </thead>
                    <tbody id="ai-suggestions-body">
                    </tbody>
                </table>
            </div>
            <div class="modal-footer bg-dark">
                <button type="button" class="btn btn-outline-light" data-dismiss="modal">Odrzuć</button>
                <button type="button" class="btn btn-warning text-bold shadow" onclick="window.confirmAiDispatch()">
                    <i class="fas fa-check-double"></i> Zatwierdź i Zadysponuj Wskazane Siły
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rankModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content dark-mode border-warning">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-dark font-weight-bold">Zmiana Rangi Operatora</h5>
                <button type="button" class="close text-dark" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editOperatorId">
                <div class="form-group">
                    <label>Wybierz nową rangę:</label>
                    <select id="editOperatorRank" class="form-control">
                        <option value="Dyspozytor112">Dyspozytor 112</option>
                        <option value="Admin112">Administrator 112</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Anuluj</button>
                <button type="button" class="btn btn-warning" onclick="window.submitRankChange()">Zmień Rangę</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="incidentDetailsModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-eye"></i> Podgląd Zgłoszenia 112</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Zamknij"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item d-flex justify-content-between">
                        <b>Numer:</b> <span class="text-info font-weight-bold" id="det-number">...</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <b>Typ zdarzenia:</b> <span class="font-weight-bold text-danger" id="det-type">...</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <b>Priorytet:</b> <span id="det-severity">...</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <b>Status:</b> <span id="det-status">...</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <b>Lokalizacja:</b> <span class="text-muted" id="det-address">...</span>
                    </li>
                </ul>
                <div class="alert alert-secondary mb-2">
                    <strong>Opis zdarzenia:</strong><br />
                    <span id="det-desc">...</span>
                </div>
                <div id="det-attachments"></div>
                <div id="det-map" style="height: 260px; border-radius: 6px; display:none;" class="border mt-2"></div>
                <a id="det-nav-link" href="#" target="_blank" rel="noopener" class="btn btn-sm btn-success btn-block mt-2 d-none">
                    <i class="fas fa-route"></i> Otwórz nawigację (Google Maps)
                </a>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Zamknij</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="statusModal" tabindex="-1" role="dialog">
    <div class="modal-dialog shadow-lg">
        <div class="modal-content border-info">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title font-weight-bold">Aktualizacja Parametrów Zdarzenia</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form id="changeStatusForm">
                <div class="modal-body">
                    <input type="hidden" id="editIncidentId">
                    <div class="form-group">
                        <label>Status operacyjny</label>
                        <select id="editIncidentStatus" class="form-control">
                            <option value="Nowe">Nowe</option>
                            <option value="W toku">W toku</option>
                            <option value="Zakończone">Zakończone</option>
                            <option value="Fałszywy alarm">Fałszywy alarm</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Poziom Zagrożenia (Severity)</label>
                        <select id="editIncidentPriority" class="form-control">
                            <option value="4">Krytyczny</option>
                            <option value="3">Wysoki</option>
                            <option value="2">Średni</option>
                            <option value="1">Niski</option>
                        </select>
                    </div>
                    <div id="editIncidentAttachments" class="mb-3"></div>
                    <div class="form-group">
                        <label><i class="fas fa-paperclip"></i> Dodaj załączniki</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="editIncPhoto" accept="image/*,.pdf,.docx,.webp" multiple>
                            <label class="custom-file-label" for="editIncPhoto" id="editIncPhotoLabel">Dodaj pliki...</label>
                        </div>
                        <small class="text-muted">JPG, PNG, WEBP, PDF, DOCX — do 5 MB każdy, max 10 na zgłoszenie</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link text-muted" data-dismiss="modal">Zamknij</button>
                    <button type="submit" class="btn btn-info font-weight-bold shadow-sm" id="btn-save-status">Zaktualizuj bazę</button>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

