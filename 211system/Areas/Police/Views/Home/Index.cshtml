@{
    ViewData["Title"] = "Komisariaty Policji";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h1 class="m-0 text-primary"><i class="fas fa-shield-alt"></i> Lista Komisariatów</h1>
        <a href="/Police/Home/Create" class="btn btn-primary d-none" id="btn-add-dept"><i class="fas fa-plus"></i> Dodaj Komisariat</a>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card card-primary card-outline dark-mode">
            <div class="card-header">
                <h3 class="card-title">Zarządzanie jednostkami policji</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 10px">#</th>
                            <th>Nazwa Placówki</th>
                            <th>Adres</th>
                            <th>Region / Dzielnica</th>
                            <th style="width: 150px" class="text-center">Akcje</th>
                        </tr>
                    </thead>
                    <tbody id="departments-table-body">
                        <tr><td colspan="5" class="text-center">Ładowanie danych...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api-custom-list-handler.js"></script>
    <script>
        window.parseJwt = window.parseJwt || function (token) {
            try { return JSON.parse(window.atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))); } catch (e) { return null; }
        };

        document.addEventListener("DOMContentLoaded", function () {
            const token = localStorage.getItem('jwt');
            if (token) {
                const decoded = window.parseJwt(token);
                if (decoded) {
                    let roleClaim = decoded["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || decoded.role;
                    let roles = Array.isArray(roleClaim) ? roleClaim : [roleClaim];
                    if (roles.includes("Admin") || roles.includes("Inspektor")) {
                        document.getElementById('btn-add-dept').classList.remove('d-none');
                    }
                }
            }
        });

        setupCustomList({
            tableBodyId: 'departments-table-body',
            colspan: 5,
            emptyMessage: 'Brak przypisanych komisariatów w systemie.',
            loadData: async (jwt) => {
                const decoded = window.parseJwt(jwt);
                let roles = [];
                let email = "";
                if (decoded) {
                    let roleClaim = decoded["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || decoded.role;
                    roles = Array.isArray(roleClaim) ? roleClaim : [roleClaim];
                    email = decoded["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"] || decoded.email || "";
                }

                const response = await fetch('/api/Police/departments', { headers: { 'Authorization': 'Bearer ' + jwt } });
                if (!response.ok) throw new Error("Błąd pobierania placówek");
                let depts = await response.json();

                if (!roles.includes("Admin") && !roles.includes("Inspektor")) {
                    const paramResponse = await fetch('/api/Police/policemen', { headers: { 'Authorization': 'Bearer ' + jwt } });
                    if (paramResponse.ok) {
                        const staff = await paramResponse.json();
                        const myRecord = staff.find(p => p.email === email || p.Email === email);

                        if (myRecord) {
                            const myDeptId = myRecord.pDepartmentId || myRecord.PDepartmentId;
                            depts = depts.filter(h => (h.id || h.Id) === myDeptId);

                            if (depts.length === 1) {
                                window.location.href = `/Police/Home/Details/${myDeptId}`;
                                return null;
                            }
                        } else {
                            depts = [];
                        }
                    }
                }
                return depts;
            },
            renderRow: (dept, index) => {
                return `
                    <tr>
                        <td>${index + 1}</td>
                        <td><b>${dept.name || dept.Name}</b></td>
                        <td>${dept.address || dept.Address}</td>
                        <td>${dept.region || dept.Region || "Brak danych"}</td>
                        <td class="text-center">
                            <a href="/Police/Home/Details/${dept.id || dept.Id}" class="btn btn-sm btn-primary" title="Szczegóły">
                                <i class="fas fa-shield-alt"></i> Zarządzaj
                            </a>
                        </td>
                    </tr>
                `;
            }
        });
    </script>
}