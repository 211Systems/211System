@{
    ViewData["Title"] = "Komisariaty Policji";
}
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h1 class="m-0 text-primary"><i class="fas fa-shield-alt"></i> Lista Komisariatów</h1>
    </div>
</div>
@{
    ViewBag.ThemeColor = "primary";
    ViewBag.Icon = "fas fa-building";
    ViewBag.Title = "Zarządzanie jednostkami policji";
    ViewBag.AddButtonText = "Dodaj Komisariat";
    ViewBag.AddLink = "/Police/Home/Create";
    ViewBag.TableBodyId = "departments-table-body";
    ViewBag.Col4Name = "Region / Dzielnica";
}
@await Html.PartialAsync("~/Views/Shared/_DepartmentListPartial.cshtml")

@section Scripts {
    <script src="~/js/auth-handler.js" asp-append-version="true"></script>
    <script src="~/js/api-custom-list-handler.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const jwt = localStorage.getItem('jwt');
            if (!jwt) {
                window.location.href = "/AuthView/Login";
                return;
            }

            const decoded = window.parseJwt(jwt);
            let roles = [];
            let email = "";

            if (decoded) {
                let roleClaim = decoded["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || decoded.role;
                roles = Array.isArray(roleClaim) ? roleClaim : [roleClaim];
                email = decoded["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"] || decoded.email || "";

                if (roles.includes("Admin") || roles.includes("Inspektor")) {
                    document.getElementById('btn-add-dept').classList.remove('d-none');
                }
            }

            await setupCustomList({
                tableBodyId: 'departments-table-body',
                colspan: 5,
                emptyMessage: 'Brak przypisanych komisariatów w systemie.',
                loadData: async () => {
                    const response = await fetch('/api/Police/departments', {
                        headers: { 'Authorization': 'Bearer ' + jwt }
                    });
                    if (!response.ok) throw new Error("Błąd pobierania placówek");
                    let depts = await response.json();

                    if (!roles.includes("Admin") && !roles.includes("Inspektor")) {
                        const paramResponse = await fetch('/api/Police/policemen', {
                            headers: { 'Authorization': 'Bearer ' + jwt }
                        });
                        if (paramResponse.ok) {
                            const staff = await paramResponse.json();
                            const myRecord = staff.find(p => p.email === email || p.Email === email);

                            if (myRecord) {
                                const myDeptId = myRecord.pDepartmentId || myRecord.PDepartmentId;
                                depts = depts.filter(h => (h.id || h.Id) === myDeptId);

                                if (depts.length === 1) {
                                    window.location.href = `/Police/Home/Details/${myDeptId}`;
                                    return null;
                                }
                            } else {
                                depts = [];
                            }
                        }
                    }
                    return depts;
                },
                renderRow: (dept, index) => {
                    return `
                        <tr>
                            <td>${index + 1}</td>
                            <td><b>${dept.name || dept.Name}</b></td>
                            <td>${dept.address || dept.Address}</td>
                            <td>${dept.district || dept.District || dept.region || dept.Region || "Brak danych"}</td>
                            <td class="text-center">
                                <a href="/Police/Home/Details/${dept.id || dept.Id}" class="btn btn-sm btn-primary" title="Zarządzaj">
                                    <i class="fas fa-shield-alt"></i> Zarządzaj
                                </a>
                            </td>
                        </tr>
                    `;
                }
            }, jwt);
        });
    </script>
}