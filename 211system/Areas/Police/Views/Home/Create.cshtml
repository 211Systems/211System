@{
    ViewData["Title"] = "Rejestracja Komisariatu";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card card-primary card-outline dark-mode">
            <div class="card-header">
                <h3 class="card-title">Wprowadź dane nowej jednostki</h3>
            </div>
            <form id="createDepartmentForm">
                <div class="card-body">
                    <div class="form-group">
                        <label>Nazwa Placówki</label>
                        <input type="text" id="deptName" class="form-control" required placeholder="np. Komenda Główna">
                    </div>
                    <div class="form-group">
                        <label>Adres</label>
                        <input type="text" id="deptAddress" class="form-control" required placeholder="np. ul. Puławska 148/150">
                    </div>
                    <div class="form-group">
                        <label>Region / Dzielnica</label>
                        <input type="text" id="deptRegion" class="form-control" required placeholder="np. Mokotów">
                    </div>
                    <p id="error-message" class="text-danger d-none"></p>
                </div>
                <div class="card-footer text-right">
                    <a href="/Police/Home" class="btn btn-secondary">Anuluj</a>
                    <button type="submit" class="btn btn-primary" id="btn-submit">Zarejestruj</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('createDepartmentForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('btn-submit');
            const errorMsg = document.getElementById('error-message');
            
            btn.disabled = true;
            errorMsg.classList.add('d-none');

            const payload = {
                name: document.getElementById('deptName').value,
                address: document.getElementById('deptAddress').value,
                region: document.getElementById('deptRegion').value
            };

            try {
                const token = localStorage.getItem('jwt');
                const response = await fetch('/api/Police/departments', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    window.location.href = '/Police/Home';
                } else {
                    errorMsg.textContent = "Błąd rejestracji placówki. Sprawdź uprawnienia.";
                    errorMsg.classList.remove('d-none');
                    btn.disabled = false;
                }
            } catch (error) {
                errorMsg.textContent = "Błąd komunikacji z serwerem.";
                errorMsg.classList.remove('d-none');
                btn.disabled = false;
            }
        });
    </script>
}