@{
    ViewData["Title"] = "Flota Radiowozów";
}

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h1 class="m-0 text-primary"><i class="fas fa-car-side"></i> Rejestr Radiowozów</h1>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between">
                <h5 class="m-0"><i class="fas fa-map-marked-alt"></i> Mapa Dyslokacji Floty</h5>
                <button class="btn btn-sm btn-light text-primary" onclick="drawFleetMap()"><i class="fas fa-sync"></i> Odśwież</button>
            </div>
            <div class="card-body p-0">
                <div id="fleet-map" style="height: 400px; width: 100%; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;"></div>
            </div>
        </div>
    </div>
</div>

@{
    ViewBag.ThemeColor = "primary";
    ViewBag.Icon = "fas fa-car";
    ViewBag.Title = "Zarejestrowane pojazdy policyjne";
    ViewBag.AddButtonText = "Zarejestruj Radiowóz";
    ViewBag.TableBodyId = "vehicles-table-body";
    ViewBag.Col2Name = "Nr Rejestracyjny";
    ViewBag.Col2_5Name = "";
    ViewBag.Col3Name = "Przypisana Komenda";
    ViewBag.Col4Name = "Przypisany Funkcjonariusz";
}
@await Html.PartialAsync("~/Views/Shared/_VehicleListPartial.cshtml")


<div class="modal fade" id="addVehicleModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content dark-mode">
            <div class="modal-header bg-primary">
                <h5 class="modal-title"><i class="fas fa-car"></i> Dodaj Radiowóz</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form id="addVehicleForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Numer Rejestracyjny</label>
                        <input type="text" id="add-veh-plate" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Komenda</label>
                        <select id="add-veh-dept" class="form-control" required>
                            <option value="">Wczytywanie...</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Przypisz Funkcjonariusza</label>
                        <select id="add-veh-personnel" class="form-control" required disabled>
                            <option value="">-- Wybierz najpierw komendę --</option>
                        </select>
                        <small class="text-muted">Wyświetlani są tylko funkcjonariusze bez przypisanego pojazdu.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Anuluj</button>
                    <button type="submit" class="btn btn-primary">Zapisz</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editVehicleModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content dark-mode">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-edit"></i> Edytuj Radiowóz</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form id="editVehicleForm">
                <div class="modal-body">
                    <input type="hidden" id="edit-veh-id">
                    <div class="form-group">
                        <label>Numer Rejestracyjny</label>
                        <input type="text" id="edit-veh-plate" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Przypisz Funkcjonariusza</label>
                        <select id="edit-veh-personnel" class="form-control">
                            <option value="">Brak przypisania</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Anuluj</button>
                    <button type="submit" class="btn btn-warning text-dark">Zapisz Zmiany</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="equipmentModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content dark-mode">
            <div class="modal-header bg-info">
                <h5 class="modal-title"><i class="fas fa-briefcase"></i> Wyposażenie Radiowozu</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Nazwa Sprzętu</th>
                            <th style="width: 100px;" class="text-center">Ilość</th>
                            <th style="width: 80px;" class="text-right">Akcje</th>
                        </tr>
                    </thead>
                    <tbody id="eq-table-body">
                        <tr><td colspan="3" class="text-center">Ładowanie...</td></tr>
                    </tbody>
                </table>
                <hr>
                <form id="addEqForm">
                    <input type="hidden" id="eq-veh-id">
                    <div class="row">
                        <div class="col-md-7">
                            <input type="text" id="eq-name" class="form-control form-control-sm" placeholder="Nazwa sprzętu" required>
                        </div>
                        <div class="col-md-3">
                            <input type="number" id="eq-qty" class="form-control form-control-sm" placeholder="Ilość" min="1" value="1" required>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-sm btn-info btn-block"><i class="fas fa-plus"></i> Dodaj</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script src="~/js/api-form-handler.js"></script>
    <script>
        const token = localStorage.getItem('jwt');
        window.allVehicles = [];
        window.allPersonnel = [];
        window.allDepartments = [];

        let isPoliceManager = false;
        if (token) {
            const dec = JSON.parse(window.atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
            let roles = dec["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || dec.role;
            let rArr = Array.isArray(roles) ? roles : [roles];
            if (rArr.includes("Admin") || rArr.includes("Inspektor") || rArr.includes("Komendant")) isPoliceManager = true;
        }

        document.addEventListener("DOMContentLoaded", async function () {
            if (isPoliceManager) document.getElementById('btn-add-vehicle').classList.remove('d-none');
            await fetchData();
        });

        async function fetchData() {
            try {
                const [vehRes, depRes, persRes] = await Promise.all([
                    fetch('/api/Police/cars', { headers: { 'Authorization': 'Bearer ' + token } }),
                    fetch('/api/Police/departments', { headers: { 'Authorization': 'Bearer ' + token } }),
                    fetch('/api/Police/policemen', { headers: { 'Authorization': 'Bearer ' + token } })
                ]);

                if (vehRes.ok && depRes.ok && persRes.ok) {
                    window.allVehicles = await vehRes.json();
                    window.allDepartments = await depRes.json();
                    window.allPersonnel = await persRes.json();
                    renderTable();
                    drawFleetMap();
                }
            } catch (e) { document.getElementById('vehicles-table-body').innerHTML = '<tr><td colspan="6" class="text-danger text-center">Błąd sieci.</td></tr>'; }
        }

        function getOccupiedPersonnelIds(excludeVehicleId = null) {
            return window.allVehicles
                .filter(v => (v.id || v.Id) !== excludeVehicleId)
                .map(v => v.policemanId || v.PolicemanId)
                .filter(Boolean);
        }

        function renderTable() {
            const tbody = document.getElementById('vehicles-table-body');
            tbody.innerHTML = '';
            if (window.allVehicles.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center">Brak pojazdów.</td></tr>';
                return;
            }

            window.allVehicles.forEach((v, index) => {
                const vId = v.id || v.Id;
                const plate = v.licensePlate || v.LicensePlate;
                const deptId = v.pDepartmentId || v.PDepartmentId;
                const persId = v.policemanId || v.PolicemanId;

                const dept = window.allDepartments.find(d => (d.id || d.Id) === deptId);
                const pers = window.allPersonnel.find(p => (p.id || p.Id) === persId);

                const deptName = dept ? (dept.name || dept.Name) : "Brak";
                const persName = pers ? `${pers.name || pers.Name} ${pers.lastname || pers.Lastname || ""}` : '<span class="text-danger">Nieprzypisany</span>';
                const statusBadge = (v.isAvailable !== false) ? '<span class="badge badge-success">W bazie</span>' : '<span class="badge badge-warning text-dark">W akcji</span>';

                let actions = `
                    <button onclick="focusMap(${dept.latitude || dept.Latitude || 0}, ${dept.longitude || dept.Longitude || 0})" class="btn btn-sm btn-secondary" title="Pokaż bazę na mapie"><i class="fas fa-map-marker-alt"></i></button>
                `;
                        if (isPoliceManager) {
                            actions += `
                                <button onclick="openEqModal('${vId}')" class="btn btn-sm btn-info ml-1" title="Wyposażenie"><i class="fas fa-briefcase"></i></button>
                                <button onclick="openEditModal('${vId}', '${plate}', '${deptId}', '${persId}')" class="btn btn-sm btn-warning text-dark ml-1"><i class="fas fa-edit"></i></button>
                                <button onclick="deleteVehicle('${vId}')" class="btn btn-sm btn-danger ml-1"><i class="fas fa-trash"></i></button>
                            `;
                        }

                tbody.insertAdjacentHTML('beforeend', `
                    <tr>
                        <td>${index + 1}</td>
                        <td><b>${plate}</b></td>
                        <td>${deptName}</td>
                        <td>${persName}</td>
                        <td>${statusBadge}</td>
                        <td class="text-right" style="white-space:nowrap;">${actions}</td>
                    </tr>
                `);
            });
        }

        window.openAddModal = function() {
            const select = document.getElementById('add-veh-dept');
            select.innerHTML = '<option value="">-- Wybierz komendę --</option>';
            window.allDepartments.forEach(d => select.innerHTML += `<option value="${d.id || d.Id}">${d.name || d.Name}</option>`);
            
            document.getElementById('add-veh-personnel').innerHTML = '<option value="">-- Wybierz najpierw komendę --</option>';
            document.getElementById('add-veh-personnel').disabled = true;
            document.getElementById('addVehicleForm').reset();
            $('#addVehicleModal').modal('show');
        }

        document.getElementById('add-veh-dept').addEventListener('change', function() {
            const deptId = this.value;
            const pSelect = document.getElementById('add-veh-personnel');
            if (!deptId) { pSelect.disabled = true; return; }

            const occupied = getOccupiedPersonnelIds();
            const availableStaff = window.allPersonnel.filter(s => (s.pDepartmentId || s.PDepartmentId) === deptId && !occupied.includes(s.id || s.Id));

            pSelect.innerHTML = '<option value="">-- Wybierz pracownika --</option>';
            availableStaff.forEach(s => pSelect.innerHTML += `<option value="${s.id || s.Id}">${s.name || s.Name} ${s.lastname || s.Lastname || ""}</option>`);
            pSelect.disabled = false;
        });

        document.getElementById('addVehicleForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const payload = {
                licensePlate: document.getElementById('add-veh-plate').value,
                pDepartmentId: document.getElementById('add-veh-dept').value,
                policemanId: document.getElementById('add-veh-personnel').value
            };
            const res = await fetch('/api/Police/cars', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            if (res.ok) { $('#addVehicleModal').modal('hide'); await fetchData(); }
        });

        window.openEditModal = function(id, plate, deptId, persId) {
            document.getElementById('edit-veh-id').value = id;
            document.getElementById('edit-veh-plate').value = plate;
            
            const pSelect = document.getElementById('edit-veh-personnel');
            const occupied = getOccupiedPersonnelIds(id);
            const availableStaff = window.allPersonnel.filter(s => (s.pDepartmentId || s.PDepartmentId) === deptId && !occupied.includes(s.id || s.Id));

            pSelect.innerHTML = '<option value="">Brak przypisania</option>';
            availableStaff.forEach(s => pSelect.innerHTML += `<option value="${s.id || s.Id}">${s.name || s.Name} ${s.lastname || s.Lastname || ""}</option>`);
            pSelect.value = persId || "";
            
            $('#editVehicleModal').modal('show');
        }

        document.getElementById('editVehicleForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('edit-veh-id').value;
            const payload = {
                licensePlate: document.getElementById('edit-veh-plate').value,
                policemanId: document.getElementById('edit-veh-personnel').value || null
            };
            const res = await fetch(`/api/Police/cars/${id}`, { method: 'PUT', headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            if (res.ok) { $('#editVehicleModal').modal('hide'); await fetchData(); }
        });

        window.deleteVehicle = async function(id) {
            if (!confirm("Wyrejestrować pojazd?")) return;
            const res = await fetch(`/api/Police/cars/${id}`, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token } });
            if (res.ok) await fetchData();
        };

        window.openEqModal = function(carId) {
            document.getElementById('eq-veh-id').value = carId;
            loadEq(carId);
            $('#equipmentModal').modal('show');
        }

        async function loadEq(carId) {
            const tbody = document.getElementById('eq-table-body');
            const res = await fetch(`/api/Police/cars/${carId}/equipment`, { headers: { 'Authorization': 'Bearer ' + token }});
            if (res.ok) {
                const eqList = await res.json();
                tbody.innerHTML = eqList.length ? '' : '<tr><td colspan="3" class="text-center">Brak wyposażenia.</td></tr>';
                eqList.forEach(eq => {
                    tbody.insertAdjacentHTML('beforeend', `<tr>
                        <td>${eq.name || eq.Name}</td><td class="text-center">${eq.quantity || eq.Quantity}</td>
                        <td class="text-right"><button onclick="deleteEq('${eq.id || eq.Id}', '${carId}')" class="btn btn-xs btn-danger"><i class="fas fa-times"></i></button></td>
                    </tr>`);
                });
            }
        }

        document.getElementById('addEqForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const carId = document.getElementById('eq-veh-id').value;
            const payload = { name: document.getElementById('eq-name').value, quantity: parseInt(document.getElementById('eq-qty').value) };
            const res = await fetch(`/api/Police/cars/${carId}/equipment`, { method: 'POST', headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            if (res.ok) { document.getElementById('eq-name').value = ''; loadEq(carId); }
        });

        window.deleteEq = async function(eqId, carId) {
            await fetch(`/api/Police/equipment/${eqId}`, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token }});
            loadEq(carId);
        }

        let fleetMap = null;
        let fleetMarkers = null;

        function initMap() {
            if (!fleetMap) {
                fleetMap = L.map('fleet-map').setView([52.2297, 21.0122], 11);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors'
                }).addTo(fleetMap);
                fleetMarkers = L.featureGroup().addTo(fleetMap);
            }
        }

        window.drawFleetMap = function() {
            initMap();
            fleetMarkers.clearLayers();

            window.allDepartments.forEach(dept => {
                const lat = dept.latitude || dept.Latitude;
                const lng = dept.longitude || dept.Longitude;

                if (lat && lng && lat !== 0) {
                    const carsHere = window.allVehicles.filter(v => (v.pDepartmentId || v.PDepartmentId) === (dept.id || dept.Id));
                    const availableCars = carsHere.filter(v => v.isAvailable !== false).length;

                    let blueIcon = new L.Icon({
                        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png',
                        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                        iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34]
                    });

                    L.marker([lat, lng], {icon: blueIcon})
                        .bindPopup(`<b><i class="fas fa-shield-alt text-primary"></i> ${dept.name || dept.Name}</b><br>Dostępnych radiowozów: <b>${availableCars} / ${carsHere.length}</b>`)
                        .addTo(fleetMarkers);
                }
            });

            setTimeout(() => { fleetMap.invalidateSize(); }, 500);
        }

        window.focusMap = function(lat, lng) {
            initMap();
            if (lat !== 0 && lng !== 0) {
                window.scrollTo({ top: 0, behavior: 'smooth' });
                fleetMap.flyTo([lat, lng], 15, { animate: true, duration: 1.5 });
            } else {
                alert("Ta komenda nie ma jeszcze przypisanych współrzędnych GPS!");
            }
        }
    </script>
}